  .doc p { font-size: 13.5px; color: var(--muted); }
  .diag-cta { margin-top: 26px; display: flex; gap: 12px; flex-wrap: wrap; }
  .diag-cta .btn { flex: 1 1 0; min-width: 0; }
  /* faq */
  .faq { max-width: 820px; margin: 48px auto 0; }
  .faq details { border-bottom: 1px solid var(--border); padding: 6px 0; }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 20px; padding: 12px 0; font-family: var(--disp); font-size: 18px; font-weight: 600; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary span { color: var(--accent); font-weight: 400; }
  .faq details p { color: var(--muted); padding: 0 0 14px; max-width: 62ch; font-size: 15.5px; }
  /* final */
  .final { background: #102654; color: #fff; text-align: center; padding: 150px 0; border-top: 4px solid #5e85e3; }
  .final .eyebrow { color: rgba(255, 255, 255, 0.78); justify-content: center; }
  .final .eyebrow::before { background: #fff; }
  .final .btn-a { background: #fff; color: var(--accent); }
  .final .btn-a:hover { background: #dce6ff; }
  .final h2 { font-size: clamp(34px, 4.6vw, 64px); max-width: 18ch; margin: 0 auto 18px; }
  .final p { color: rgba(255, 255, 255, 0.85); max-width: 52ch; margin: 0 auto; }
  @media (max-width: 960px) {
    section { padding: 72px 0; }
    .hero-grid, .aion-grid, .diag-grid { grid-template-columns: 1fr; }
    .aion-grid .mock { margin: 48px 0 0; }
    section[data-od-id='casos-mas'] { padding-top: 110px !important; padding-bottom: 60px !important; }
    .aion { padding-bottom: 110px; }
    .prow { grid-template-columns: 44px 1fr; row-gap: 6px; }
    .prow p { grid-column: 2; }
    .prow .tag { display: none; }
    .cf-row { grid-template-columns: 1fr; gap: 8px; padding: 24px 0; }
    .cf-row i { transform: rotate(90deg); justify-self: start; }
    .ba { grid-template-columns: 1fr; }
    .ba-mid { justify-self: center; transform: rotate(90deg); }
    .cap-grid, .cases, .why-grid { grid-template-columns: 1fr; gap: 0; }
    .cap { padding: 26px 0; }
    .why { padding-bottom: 36px; }
    .tnodes { grid-template-columns: 1fr; gap: 0; margin-top: 24px; }
    .tnode { display: grid; grid-template-columns: 1fr; gap: 4px; padding: 14px 0 14px 22px; border-left: 2px solid var(--border); margin-left: 6px; position: relative; }
    .tnode .pt { position: absolute; left: -8px; top: 20px; margin: 0; }
    .tnode.active { border-left-color: var(--accent); }
    .tnode .pq { min-height: 0; }
    .tbar, .tnodes, .pane, .t-hint { display: none; }
    .m-steps { display: block; margin-top: 8px; }
    .m-step { padding: 24px 0; border-top: 1px solid var(--border); }
    .m-step:last-child { border-bottom: 1px solid var(--border); }
    .m-step .pk { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; color: var(--accent); margin-bottom: 12px; }
    .m-step blockquote { font-size: 22px; font-family: var(--disp); letter-spacing: -0.02em; line-height: 1.25; margin-bottom: 10px; }
    .m-step p { color: var(--muted); font-size: 15px; }
    .m-step .m-out { margin-top: 14px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; color: var(--accent); }
    .m-step .m-out span { display: block; font-family: var(--disp); font-size: 18px; letter-spacing: 0; color: var(--fg); margin-top: 6px; }
    .pane .res { border-left: 0; border-top: 1px solid var(--border); padding: 20px 0 0; }
    .mock-body { grid-template-columns: 1fr; }
    .mock-side { display: none; }
    .facts div { flex-direction: column; gap: 4px; }
    .facts b { min-width: 0; }
    .hero .cta-row { flex-direction: column; align-items: stretch; }
    .hero .cta-row .btn { width: 100%; }
    .diag-cta { flex-direction: column; align-items: stretch; }
    .diag-cta .btn { width: 100%; }
  }
</style>

<script>
  // process tabs (desktop) + stacked steps (mobile)
  var data = [
    { q: '¿Qué está pasando?', c: 'Entendemos cómo trabaja hoy tu equipo, qué quiere conseguir el negocio, qué está generando trabajo innecesario y qué depende de trabajo manual.', r: 'Problema y contexto claros.' },
    { q: '¿Qué vale la pena resolver?', c: 'Convertimos lo aprendido en prioridades, alcance y una dirección concreta antes de invertir en desarrollo.', r: 'Solución y roadmap inicial.' },
    { q: 'Convertimos la dirección en producto.', c: 'Diseñamos y desarrollamos el sistema, sus integraciones y automatizaciones alrededor del alcance acordado.', r: 'Software listo para entrar en operación.' },
    { q: 'El software empieza a convivir con el negocio.', c: 'Implementamos, conectamos datos y herramientas, acompañamos usuarios y llevamos la solución a la operación real.', r: 'Sistema en uso.' },
    { q: 'Lo que funciona hoy puede necesitar cambiar mañana.', c: 'Medimos, aprendemos y evolucionamos el sistema a medida que cambian usuarios, procesos y necesidades del negocio.', r: 'Una solución que puede crecer con la operación.' }
  ];
  var nodes = document.querySelectorAll('.tnode');
  var prog = document.getElementById('tprog');
  var paneEl = document.getElementById('pane');
  var stageNames = ['DISCOVER', 'SHAPE', 'BUILD', 'LAUNCH', 'EVOLVE'];
  var mSteps = document.getElementById('mSteps');
  if (mSteps) {
    var mHtml = '';
    data.forEach(function (d, i) {
      mHtml += '<div class="m-step"><div class="pk">0' + (i + 1) + ' / ' + stageNames[i] + '</div><blockquote>' + d.q + '</blockquote><p>' + d.c + '</p><div class="m-out">OUTPUT 0' + (i + 1) + '<span>' + d.r + '</span></div></div>';
    });
    mSteps.innerHTML = mHtml;
  }
  nodes.forEach(function (n) {
    n.addEventListener('click', function () {
      nodes.forEach(function (x) { x.classList.remove('active'); });
      n.classList.add('active');
      var i = +n.dataset.i;
      if (prog) prog.style.width = (i / (nodes.length - 1)) * 100 + '%';
      if (!paneEl) return;
      paneEl.style.opacity = 0;
      setTimeout(function () {
        document.getElementById('pq').textContent = data[i].q;
        document.getElementById('pc').textContent = data[i].c;
        document.getElementById('pr').textContent = data[i].r;
        document.getElementById('pk').textContent = '0' + (i + 1) + ' / ' + stageNames[i];
        document.getElementById('plabel').textContent = 'OUTPUT 0' + (i + 1);
        paneEl.style.opacity = 1;
      }, 160);
    });
  });
  var autoTimer = null;
  function autoAdvance() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.matchMedia('(max-width: 960px)').matches || autoTimer) return;
    autoTimer = setInterval(function () {
      if (document.hidden) return;
      var cur = 0;
      nodes.forEach(function (x, j) { if (x.classList.contains('active')) cur = j; });
      nodes[(cur + 1) % nodes.length].click();
    }, 6000);
  }
  function resetAuto() { if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } autoAdvance(); }
  nodes.forEach(function (n) { n.addEventListener('click', resetAuto); });
  var tnodesEl = document.getElementById('tnodes');
  if (tnodesEl) {
    tnodesEl.addEventListener('mouseenter', function () { if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } });
    tnodesEl.addEventListener('mouseleave', autoAdvance);
  }
  autoAdvance();
  if (prog) prog.style.width = '0%';
  // faq: single-open accordion
  document.querySelectorAll('.faq details').forEach(function (d) {
    d.addEventListener('toggle', function () {
      if (d.open) document.querySelectorAll('.faq details').forEach(function (o) { if (o !== d) o.open = false; });
    });
  });
</script>
