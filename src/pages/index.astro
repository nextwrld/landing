  .btn-a{background:var(--accent);color:#fff}
  /* cases */
  #casos-mas{padding-top:120px;padding-bottom:56px}
  .cases{display:grid;grid-template-columns:repeat(2,1fr);gap:32px;margin-top:32px;align-items:stretch}
  .case{display:flex;flex-direction:column;border-top:2px solid var(--accent);padding-top:24px}
  .case-ic{width:24px;height:24px;color:var(--accent);display:block;margin-bottom:10px}
  .case .who{font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--accent)}
  .case h3{font-family:var(--disp);font-size:22px;margin:12px 0 8px}
  .case p{color:var(--muted);font-size:15px}
  .case a{font-weight:600;font-size:14px;border-bottom:2px solid var(--accent);text-decoration:none;align-self:flex-start;margin-top:auto;padding-top:14px}
  /* diag */
  .diag-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin-top:40px}
  .facts{border-top:1px solid var(--border);margin-top:24px}
  .facts div{display:flex;gap:20px;align-items:baseline;padding:16px 0;border-bottom:1px solid var(--border)}
  .facts b{font-family:var(--disp);font-size:18px;min-width:140px}
  .facts span{font-size:14px;color:var(--muted)}
  .doc{background:var(--surface);border:1px solid #d8e0ec;border-radius:var(--r-lg);overflow:hidden;box-shadow:0 44px 90px -30px rgba(16,38,84,.3)}
  .doc-head{background:var(--accent);color:#fff;padding:20px 24px;display:flex;justify-content:space-between;align-items:center}
  .doc-head b{font-family:var(--disp)}
  .doc-head span{font-family:var(--mono);font-size:11px;opacity:.7}
  .doc ol{list-style:none;padding:8px 24px 20px}
  .doc li{display:grid;grid-template-columns:40px 1fr;gap:14px;padding:14px 0;border-bottom:1px solid var(--border)}
  .doc li:last-child{border:0}
  .doc .dn{font-family:var(--mono);color:var(--accent);font-size:12px}
  .doc b{font-size:14px}
  .doc p{font-size:13.5px;color:var(--muted)}
  .doc-foot{padding:0 24px 20px;font-size:13px;color:var(--muted)}
  @media(max-width:960px){
    section{padding:72px 0}
    .hero-grid,.diag-grid{grid-template-columns:1fr}
    .pgrid{grid-template-columns:1fr}
    .cap-grid{grid-template-columns:1fr;gap:0}
    .cap{padding-bottom:28px}
    .cap p{min-height:0}
    .tbar,.pane,.t-hint,.tnodes{display:none}
    :global(.m-steps){display:grid;gap:14px;margin-top:24px}
    :global(.m-step){background:#fff;border:1px solid var(--border);border-radius:14px;padding:22px 20px}
    :global(.m-step) :global(.pk){font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--accent);margin-bottom:10px;font-weight:700;display:block}
    :global(.m-step) blockquote{font-size:20px;font-family:var(--disp);letter-spacing:-.02em;line-height:1.3;margin-bottom:10px;font-weight:600;color:var(--fg)}
    :global(.m-step) p{color:var(--muted);font-size:14.5px;line-height:1.6}
    :global(.m-step) :global(.m-out){margin-top:16px;padding-top:12px;border-top:1px solid var(--border);font-family:var(--mono);font-size:11px;letter-spacing:.08em;color:var(--accent);font-weight:700;display:block}
    :global(.m-step) :global(.m-out) span{display:block;font-family:var(--disp);font-size:16px;letter-spacing:-.01em;color:var(--fg);margin-top:6px;font-weight:600}
    .pane .res{border-left:0;border-top:1px solid var(--border);padding:20px 0 0}
    .cases{grid-template-columns:1fr}
    .aion-product{margin-bottom:0}
    #casos-mas{padding-top:72px}
    .tr-row span{text-align:left}
    .facts div{flex-direction:column;gap:4px}
    .facts b{min-width:0}
  }
</style>

<script>
  // Mobile cards are now static HTML, so cleanup JS generation no longer overwrites them
  var data = [
    { q: 'Cómo funciona hoy.', c: 'Conversamos con tu equipo, mapeamos el flujo real, las herramientas que usan y dónde el trabajo manual genera fricción, demoras o dependencia.', r: 'Problema y contexto claros.' },
    { q: 'Qué vale la pena resolver.', c: 'Transformamos lo aprendido en prioridades, alcance y roadmap inicial. Elegimos qué simplificar, conectar o construir.', r: 'Dirección y prioridades definidas.' },
    { q: 'Convertir la dirección en producto.', c: 'Diseñamos y desarrollamos el sistema, sus integraciones y automatizaciones por iteraciones, validando con uso real.', r: 'Software listo para entrar en operación.' },
    { q: 'Llevarlo a la operación real.', c: 'Conectamos datos y herramientas, migramos información y acompañamos al equipo para que el sistema conviva con el negocio.', r: 'Sistema en uso.' },
    { q: 'Adaptarlo a medida que el negocio cambia.', c: 'Medimos, aprendemos y evolucionamos el sistema a medida que entran más usuarios, procesos y necesidades.', r: 'Producto que crece con vos.' }
  ];
  // Ensure mobile cards get styled even though they are JS-generated (Astro scoped CSS doesn't hit them without :global)
  // Inject minimal mobile card CSS as a fallback if the scoped :global didn't stick
  if(!document.getElementById('m-steps-fallback')){ var s=document.createElement('style'); s.id='m-steps-fallback'; s.textContent='@media(max-width:960px){.m-steps{display:grid;gap:14px;margin-top:24px}.m-step{background:#fff;border:1px solid #e3e7ed;border-radius:14px;padding:22px 20px}.m-step .pk{font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:#2758d9;margin-bottom:10px;font-weight:700;display:block}.m-step blockquote{font-size:20px;font-family:var(--disp);letter-spacing:-.02em;line-height:1.3;margin-bottom:10px;font-weight:600;color:#111318}.m-step p{color:#667085;font-size:14.5px;line-height:1.6}.m-step .m-out{margin-top:16px;padding-top:12px;border-top:1px solid #e3e7ed;font-family:var(--mono);font-size:11px;letter-spacing:.08em;color:#2758d9;font-weight:700;display:block}.m-step .m-out span{display:block;font-family:var(--disp);font-size:16px;letter-spacing:-.01em;color:#111318;margin-top:6px;font-weight:600}}'; document.head.appendChild(s); }
  var nodes = document.querySelectorAll('.tnode');
  var prog = document.getElementById('tprog');
  var paneEl = document.getElementById('pane');
  function setPaneText(id, value){ var el=document.getElementById(id); if(el) el.textContent=value; }
  var stageNames=['DISCOVER','SHAPE','BUILD','LAUNCH','EVOLVE'];
  var stageSubs=['Entender','Decidir','Construir','Integrar','Mejorar'];
  var mSteps=document.getElementById('mSteps');
  // Static HTML already present for mobile — keep it, don't overwrite (avoids losing Astro scoped attrs)
  // Only generate if empty (fallback)
  if(mSteps && mSteps.children.length===0){ var mHtml=''; data.forEach(function(d,i){ mHtml+='<div class="m-step"><div class="pk">0'+(i+1)+' / '+stageNames[i]+' — '+stageSubs[i]+'</div><blockquote>'+d.q+'</blockquote><p>'+d.c+'</p><div class="m-out">Resultado 0'+(i+1)+'<span>'+d.r+'</span></div></div>'; }); mSteps.innerHTML=mHtml; }
  nodes.forEach(function(n){ n.addEventListener('click', function(){
    nodes.forEach(function(x){ x.classList.remove('active'); });
    n.classList.add('active');
    var i=Number(n.dataset.i||0);
    if(prog) prog.style.width=(i/(nodes.length-1))*100+'%';
    if(!paneEl) return; var stage=data[i]; if(!stage) return;
    paneEl.style.opacity='0';
    setTimeout(function(){
      setPaneText('pq', stage.q);
      setPaneText('pc', stage.c);
      setPaneText('pr', stage.r);
      setPaneText('pk', '0'+(i+1)+' / '+stageNames[i]+' — '+stageSubs[i]);
      setPaneText('plabel', 'Resultado 0'+(i+1));
      paneEl.style.opacity='1';
    },160);
  });});
  var autoTimer=null;
  function autoAdvance(){ if(window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.matchMedia('(max-width: 960px)').matches || autoTimer) return; autoTimer=setInterval(function(){ if(document.hidden) return; var cur=0; nodes.forEach(function(x,j){ if(x.classList.contains('active')) cur=j; }); var next=nodes[(cur+1)%nodes.length]; if(next) next.click(); },6000); }
  function resetAuto(){ if(autoTimer){ clearInterval(autoTimer); autoTimer=null;} autoAdvance(); }
  nodes.forEach(function(n){ n.addEventListener('click', resetAuto); });
  var tnodesEl=document.getElementById('tnodes');
  if(tnodesEl){ tnodesEl.addEventListener('mouseenter', function(){ if(autoTimer){ clearInterval(autoTimer); autoTimer=null; } }); tnodesEl.addEventListener('mouseleave', autoAdvance); }
  autoAdvance();
  if(prog) prog.style.width='0%';
</script>
