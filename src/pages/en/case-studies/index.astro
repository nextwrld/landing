---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { route } from '../../../i18n/routes';

const calendarUrl = 'https://calendar.app.google/JQnkVUqK3FF5VSRU6';
const whatsappUrl =
  'https://wa.me/5491173678601?text=Hello%2C%20I%20came%20from%20Next%20Wrld.%20I%20want%20to%20talk%20about%20a%20process%20in%20my%20company%20we%20are%20looking%20to%20improve.';
---

<BaseLayout
  locale="en"
  title="Software, automation and digital product case studies | Next Wrld"
  description="Next Wrld projects in custom software, management systems, automation, and digital products built around real problems."
  routeKey="cases"
  canonicalPath="/en/case-studies/"
>
  <section data-od-id="hero">
    <p class="eyebrow">Case studies</p>
    <h1>Different problems. The same principle: understand before building.</h1>
    <p class="lead">
      A selection of projects in custom software, management systems,
      and digital products — each one shaped by a real problem.
    </p>
    <div class="cta-row">
      <a class="btn btn-p" href="#cases" data-od-id="hero-primary">
        Explore case studies
      </a>
      <a class="btn btn-s" href={route('howWeWork', 'en')} data-od-id="hero-secondary">
        How we work
      </a>
    </div>
  </section>

  <!-- EN parity: hero translated, body sections follow ES structure -->
  <section data-od-id="cases" id="cases">
    <p class="eyebrow">Selected work</p>
    <h2>Not every problem needs the same kind of solution.</h2>
    <article id="aion">
      <p class="eyebrow">Featured case · Next Wrld product</p>
      <h3>AION Wellness</h3>
      <p>
        A gym’s daily operation connected in one multi-tenant product:
        members, plans and memberships, payments, access decisions,
        check-ins, operational indicators and daily cash close.
      </p>
      <a href="/en/case-studies/aion-wellness/">Explore the full case study</a>
      <a href="https://www.aionwellness.pro/" target="_blank" rel="noopener">Visit AION Wellness ↗</a>
    </article>
    <article id="jfhp">
      <p class="eyebrow">Platform modernization · Three-year evolution</p>
      <h3>JFHP</h3>
      <p>
        Backend, data, web and mobile evolved in controlled layers for an
        active global platform with 14K+ registered accounts, eight
        languages, regional contexts and permission-sensitive workflows.
      </p>
      <a href="/en/case-studies/jfhp/">Explore the full case study</a>
    </article>
    <article id="inmocrm">
      <h3>InmoCRM</h3>
      <p>
        From fragmented real estate operations to one connected system: a
        PropTech platform designed and built by Next Wrld to centralize
        properties, leads, visits, tasks and commercial activity.
      </p>
      <a href="/en/case-studies/inmocrm/">View full case study</a>
    </article>
  </section>

  <section data-od-id="cierre">
    <p class="eyebrow">Next step</p>
    <h2>We can start by understanding what is happening in your company.</h2>
    <div class="cta-row">
      <a class="btn btn-p" href={calendarUrl} target="_blank" rel="noopener" data-od-id="final-primary">
        Analyze my case
      </a>
      <a class="btn btn-s" href={whatsappUrl} target="_blank" rel="noopener">
        Chat on WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  section { max-width: var(--max); margin: 0 auto; padding: 88px 32px; scroll-margin-top: 80px; }
  h1 { font-size: clamp(36px, 5vw, 62px); margin: 22px 0 20px; line-height: 1.05; letter-spacing: -0.03em; }
  h2 { font-size: clamp(28px, 3.4vw, 44px); margin: 18px 0; letter-spacing: -0.02em; line-height: 1.1; }
  h3 { font-family: var(--disp); font-size: 22px; margin: 18px 0 8px; letter-spacing: -0.02em; }
  .lead { margin-top: 16px; }
  .cta-row { display: flex; gap: 14px; margin-top: 30px; flex-wrap: wrap; }
  ol { margin: 28px 0 0; padding-left: 22px; display: grid; gap: 18px; }
  li p { margin-top: 6px; color: var(--muted); }
  article { border-top: 1px solid var(--border); padding: 28px 0; }
  article p { margin-top: 10px; color: var(--muted); max-width: 64ch; }
  article a { display: inline-block; margin: 12px 16px 0 0; font-weight: 600; }
  @media (max-width: 720px) {
    section { padding: 72px 20px; }
    .cta-row { flex-direction: column; }
    .cta-row .btn { width: 100%; }
  }
</style>
