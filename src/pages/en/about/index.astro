---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { route } from '../../../i18n/routes';

const calendarUrl = 'https://calendar.app.google/JQnkVUqK3FF5VSRU6';
const whatsappUrl =
  'https://wa.me/5491173678601?text=Hello%2C%20I%20came%20from%20Next%20Wrld.%20I%20want%20to%20talk%20about%20a%20process%20in%20my%20company%20we%20are%20looking%20to%20improve.';
---

<BaseLayout
  locale="en"
  title="About | Product, design and software engineering | Next Wrld"
  description="Meet Next Wrld: our team, experience, and way of thinking about products, systems, and software solutions for companies."
  routeKey="about"
  canonicalPath="/en/about/"
>
  <section data-od-id="hero">
    <p class="eyebrow">About</p>
    <h1>We build technology with business judgment.</h1>
    <p class="lead">
      Product, design, and engineering working on the same problem: making
      your operation simpler, not adding another layer of complexity.
    </p>
    <div class="cta-row">
      <a class="btn btn-p" href={route('cases', 'en')} data-od-id="hero-primary">
        See our work
      </a>
      <a class="btn btn-s" href={route('howWeWork', 'en')} data-od-id="hero-secondary">
        How we work
      </a>
    </div>
  </section>

  <!-- EN parity: hero translated, body sections follow ES structure -->
  <section data-od-id="criterio">
    <p class="eyebrow">How we think</p>
    <h2>Software should simplify work, not add another layer of complexity.</h2>
    <p class="lead">
      Different disciplines working on the same problem, close to the
      decisions and close to the people who live with the system every day.
    </p>
  </section>

  <section data-od-id="experiencia">
    <p class="eyebrow">Experience</p>
    <h2>We have worked on systems that already have to run, and built products from scratch.</h2>
    <p class="lead">
      From legacy platforms that need to keep operating to new products
      facing their first product decisions — understand, decide, build,
      put into use, improve.
    </p>
    <a href={route('cases', 'en')}>See our work</a>
  </section>

  <section data-od-id="cierre">
    <p class="eyebrow">Talk to us</p>
    <h2>Let&rsquo;s talk with the people who will decide.</h2>
    <div class="cta-row">
      <a class="btn btn-p" href={calendarUrl} target="_blank" rel="noopener" data-od-id="final-primary">
        Analyze my case
      </a>
      <a class="btn btn-s" href={whatsappUrl} target="_blank" rel="noopener">
        Chat on WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>
