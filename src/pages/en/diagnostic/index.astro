---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { calendarUrl, whatsappUrl } from '../../../i18n/contact';
---

<BaseLayout
  locale="en"
  routeKey="diagnostic"
  canonicalPath="/en/diagnostic/"
  title="Free operational diagnostic | Next Wrld"
  description="We review a concrete process in your operation to identify frictions and opportunities. 30–45 minutes, free and with no obligation."
>
  <section class="hero" data-od-id="hero">
    <div class="wrap" data-reveal>
      <p class="eyebrow">Operational diagnostic</p>
      <h1>Before deciding what to build, let’s understand what is slowing your operation.</h1>
      <p class="lead">We review a concrete process in your operation to identify frictions and opportunities. In 30–45 minutes we assess what makes sense to simplify, connect or automate.</p>
      <div class="hero-facts">
        <span><b>30–45 min</b> Conversation</span>
        <span><b>Free</b> No cost</span>
        <span><b>No obligation</b> to hire</span>
      </div>
    </div>
  </section>

  <section data-od-id="como-funciona">
    <div class="wrap">
      <div class="grid">
        <div data-reveal>
          <p class="eyebrow">How it works</p>
          <h2>A simple process.</h2>
          <ol class="steps">
            <li><b>01 — Context</b><p>You tell us which part of the operation you want to improve: name, company, email and a brief process description.</p></li>
            <li><b>02 — Conversation</b><p>30–45 minutes with Next Wrld to understand how it works today, what creates unnecessary work and its impact.</p></li>
            <li><b>03 — Deliverable</b><p>You receive a 3–5 page mini diagnostic with situation, frictions, impact, opportunities, priorities, initial proposal and next steps.</p></li>
            <li><b>04 — Decision</b><p>You decide if you want to move forward. No pressure.</p></li>
          </ol>
        </div>
        <div data-reveal class="form-card">
          <h3>Book a diagnostic</h3>
          <p>Pick a time slot or message us on WhatsApp. We ask for brief context first, then you see the calendar.</p>
          <a class="btn btn-p full" href={calendarUrl} target="_blank" rel="noopener">Open calendar</a>
          <a class="btn btn-s full" href={whatsappUrl('en','full')} target="_blank" rel="noopener">Chat on WhatsApp</a>
          <p class="micro">By continuing you agree we use your information only to coordinate the diagnostic.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band" data-od-id="entregable">
    <div class="wrap">
      <div data-reveal>
        <p class="eyebrow">Deliverable</p>
        <h2>3–5 page mini diagnostic.</h2>
        <p class="lead">A clear document you can share with your team.</p>
      </div>
      <div class="doc-grid" data-reveal>
        <div class="doc-item"><span>01</span><b>Current situation</b><p>How the process works today.</p></div>
        <div class="doc-item"><span>02</span><b>Frictions</b><p>What causes unnecessary work or delays.</p></div>
        <div class="doc-item"><span>03</span><b>Impact</b><p>How it affects the business.</p></div>
        <div class="doc-item"><span>04</span><b>Opportunities</b><p>What could be simplified or automated.</p></div>
        <div class="doc-item"><span>05</span><b>Priorities</b><p>What to address first.</p></div>
        <div class="doc-item"><span>06</span><b>Initial proposal</b><p>What kind of solution could make sense.</p></div>
        <div class="doc-item"><span>07</span><b>Next steps</b><p>What we recommend doing next.</p></div>
      </div>
    </div>
  </section>

  <section data-od-id="faq">
    <div class="wrap">
      <div style="text-align:center" data-reveal><p class="eyebrow" style="justify-content:center">FAQ</p><h2>Before booking.</h2></div>
      <div class="faq" data-reveal>
        <details open><summary>How do I know if I need custom software? <span>+</span></summary><p>It makes sense when important processes no longer fit available tools, require too much manual work or need specific adaptations.</p></details>
        <details><summary>Do I have to replace tools I already use? <span>+</span></summary><p>Not necessarily. Often integrating or automating existing tools is better. Building anew only makes sense when it brings clear benefit.</p></details>
        <details><summary>Can we start with a single process? <span>+</span></summary><p>Yes. It’s the recommended way: start from a concrete problem, measure impact and evolve.</p></details>
        <details><summary>How long does a project take? <span>+</span></summary><p>A one-off automation can take weeks; a full system, months. The diagnostic helps understand which scenario applies.</p></details>
        <details><summary>How is pricing defined? <span>+</span></summary><p>By scope, complexity, integrations and uncertainty. If needed, we run a Discovery stage before quoting the full build.</p></details>
        <details><summary>Does the software belong to my company? <span>+</span></summary><p>Yes, under ownership conditions agreed from the start.</p></details>
        <details><summary>What happens after launch? <span>+</span></summary><p>We can keep improving: new automations, integrations and system evolution.</p></details>
        <details><summary>Where do you use AI? <span>+</span></summary><p>Only when it improves a concrete task: analyzing information, classifying data or assisting the team.</p></details>
      </div>
    </div>
  </section>

  <section class="final" data-od-id="cta-final">
    <div class="wrap" data-reveal>
      <p class="eyebrow" style="justify-content:center">Operational diagnostic</p>
      <h2>Tell us how you work today.</h2>
      <p style="color:rgba(255,255,255,.85);max-width:52ch;margin:0 auto">Let’s see where it makes sense to simplify, connect or build.</p>
      <div class="cta-row" style="justify-content:center"><a class="btn btn-w" href={calendarUrl} target="_blank" rel="noopener">Open calendar</a><a class="btn btn-g" href={whatsappUrl('en','full')} target="_blank" rel="noopener">Chat on WhatsApp</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  h1{font-size:clamp(36px,5vw,58px);margin:18px 0 16px;max-width:20ch}
  h2{font-size:clamp(28px,3.4vw,44px);margin:18px 0}
  section{padding:84px 0;scroll-margin-top:80px}
  .hero{padding:72px 0 64px}
  .hero-facts{display:flex;gap:24px;flex-wrap:wrap;margin-top:28px;font-family:var(--mono);font-size:13px;color:var(--muted)}
  .hero-facts b{color:var(--fg);font-family:var(--disp);font-size:15px;margin-right:6px}
  .grid{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:start}
  .steps{list-style:none;margin-top:24px;counter-reset:s}
  .steps li{counter-increment:s;padding:18px 0;border-bottom:1px solid var(--border)}
  .steps b{font-family:var(--disp);font-size:16px;display:block}
  .steps b::before{content:'0' counter(s) ' · ';font-family:var(--mono);color:var(--accent);font-size:12px;letter-spacing:.1em}
  .steps p{color:var(--muted);font-size:15px;margin-top:6px}
  .form-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:28px;position:sticky;top:88px}
  .form-card h3{font-family:var(--disp);font-size:22px}
  .form-card p{color:var(--muted);font-size:14px;margin:10px 0 18px}
  .form-card .full{width:100%;margin-top:10px}
  .micro{font-family:var(--mono);font-size:11.5px;color:var(--muted);margin-top:12px}
  .band{background:var(--surface-gray);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
  .doc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px}
  .doc-item{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:20px}
  .doc-item span{font-family:var(--mono);font-size:12px;color:var(--accent);font-weight:700}
  .doc-item b{display:block;margin:6px 0;font-family:var(--disp)}
  .doc-item p{color:var(--muted);font-size:14px}
  .faq{max-width:820px;margin:40px auto 0}
  .faq details{border-bottom:1px solid var(--border);padding:6px 0}
  .faq summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:20px;padding:12px 0;font-family:var(--disp);font-size:17px;font-weight:600}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary span{color:var(--accent);font-weight:400}
  .faq p{color:var(--muted);padding:0 0 14px;max-width:62ch;font-size:15px}
  .final{background:var(--navy);color:#fff;text-align:center;padding:110px 0;border-top:4px solid #5e85e3}
  .final .eyebrow{color:rgba(255,255,255,.78);justify-content:center}
  .final .eyebrow::before{background:#fff}
  .final h2{color:#fff}
  .btn-w{background:#fff;color:var(--accent)}
  .btn-g{border-color:rgba(255,255,255,.45);color:#fff}
  .cta-row{display:flex;gap:14px;margin-top:24px;flex-wrap:wrap}
  @media(max-width:960px){
    .grid{grid-template-columns:1fr}
    .form-card{position:static}
    .doc-grid{grid-template-columns:1fr}
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach(d=>{
    d.addEventListener('toggle',()=>{
      if(d.open) document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach(o=>{if(o!==d) o.open=false})
    })
  })
</script>
