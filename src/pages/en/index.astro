<script>
  // process tabs (desktop) + stacked steps (mobile)
  var data = [
    { q: 'What is happening?', c: 'We understand how your team works today, what the business wants to achieve, what is generating unnecessary work and what depends on manual work.', r: 'Clear problem and context.' },
    { q: 'What is worth solving?', c: 'We turn what we learned into priorities, scope and a concrete direction before investing in development.', r: 'Solution and initial roadmap.' },
    { q: 'We turn direction into product.', c: 'We design and develop the system, its integrations and automations around the agreed scope.', r: 'Software ready to enter operations.' },
    { q: 'Software starts living with the business.', c: 'We implement, connect data and tools, support users and bring the solution into real operations.', r: 'System in use.' },
    { q: 'What works today may need to change tomorrow.', c: 'We measure, learn and evolve the system as users, processes and business needs change.', r: 'A solution that can grow with operations.' }
  ];
  var nodes = document.querySelectorAll<HTMLButtonElement>('.tnode');
  var prog = document.getElementById('tprog');
  var paneEl = document.getElementById('pane');
  function setPaneText(id: string, value: string): void {
    var el = document.getElementById(id);
    if (el) el.textContent = value;
  }
  var stageNames = ['DISCOVER', 'SHAPE', 'BUILD', 'LAUNCH', 'EVOLVE'];
  var mSteps = document.getElementById('mSteps');
  if (mSteps) {
    var mHtml = '';
    data.forEach(function (d, i) {
      mHtml += '<div class="m-step"><div class="pk">0' + (i + 1) + ' / ' + stageNames[i] + '</div><blockquote>' + d.q + '</blockquote><p>' + d.c + '</p><div class="m-out">Outcome 0' + (i + 1) + '<span>' + d.r + '</span></div></div>';
    });
    mSteps.innerHTML = mHtml;
  }
  nodes.forEach(function (n) {
    n.addEventListener('click', function () {
      nodes.forEach(function (x) { x.classList.remove('active'); });
      n.classList.add('active');
      var i = Number(n.dataset.i ?? 0);
      if (prog) prog.style.width = (i / (nodes.length - 1)) * 100 + '%';
      const panel = paneEl;
      if (!panel) return;
      const stage = data[i];
      if (!stage) return;
      panel.style.opacity = '0';
      setTimeout(function () {
        setPaneText('pq', stage.q);
        setPaneText('pc', stage.c);
        setPaneText('pr', stage.r);
        setPaneText('pk', '0' + (i + 1) + ' / ' + stageNames[i]);
        setPaneText('plabel', 'Outcome 0' + (i + 1));
        panel.style.opacity = '1';
      }, 160);
    });
  });
  var autoTimer: ReturnType<typeof setInterval> | null = null;
  function autoAdvance() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.matchMedia('(max-width: 960px)').matches || autoTimer) return;
    autoTimer = setInterval(function () {
      if (document.hidden) return;
      var cur = 0;
      nodes.forEach(function (x, j) { if (x.classList.contains('active')) cur = j; });
      var next = nodes[(cur + 1) % nodes.length];
      if (next) next.click();
    }, 6000);
  }
  function resetAuto() { if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } autoAdvance(); }
  nodes.forEach(function (n) { n.addEventListener('click', resetAuto); });
  var tnodesEl = document.getElementById('tnodes');
  if (tnodesEl) {
    tnodesEl.addEventListener('mouseenter', function () { if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } });
    tnodesEl.addEventListener('mouseleave', autoAdvance);
  }
  autoAdvance();
  if (prog) prog.style.width = '0%';
  // faq: single-open accordion
  document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach(function (d) {
    d.addEventListener('toggle', function () {
      if (d.open) document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach(function (o) { if (o !== d) o.open = false; });
    });
  });
</script>
