---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calendarUrl, whatsappUrl } from '../../i18n/contact';
import AionProductUI from '../../components/cases/AionProductUI.astro';
---

<BaseLayout
  locale="en"
  routeKey="home"
  canonicalPath="/en/"
  title="Custom software for companies | Next Wrld"
  description="We design custom software for companies that need fewer manual processes, connected tools, and more operational control."
>
  <!-- HERO -->
  <section class="hero" data-od-id="hero">
    <div class="wrap hero-grid">
      <div data-reveal class="in">
        <p class="eyebrow">Software for growing operations</p>
        <h1>Your company shouldn’t grow by multiplying manual work.</h1>
        <p class="hero-sub lead">We design software for companies that need to centralize processes, connect tools and automate work that today depends on spreadsheets, messages and manual tasks.</p>
        <p class="hero-line">Less administration and more control over your operation.</p>
        <div class="cta-row">
          <a class="btn btn-p" href={calendarUrl} target="_blank" rel="noopener" data-od-id="hero-primary">Analyze my operation</a>
          <a class="btn btn-s" href="/en/case-studies/" data-od-id="hero-secondary">View case studies</a>
        </div>
        <p class="micro">Free diagnostic · 30–45 minutes</p>
      </div>
      <div class="sys" data-reveal data-od-id="hero-system" aria-label="From scattered tools to connected operations">
        <div class="sys-head"><span>SCATTERED TOOLS</span><span class="dotlive"><span class="pulse"></span>LIVE</span></div>
        <div class="frag">
          <div class="chip"><i><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2.5" width="12" height="11" rx="1.5"/><path d="M2 6h12M2 9.5h12M7 2.5v11"/></svg></i><div>Excel<small>Critical spreadsheets</small></div></div>
          <div class="chip"><i><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5a5.5 5.5 0 0 0-5.5 5.5c0 1.2.4 2.4 1.1 3.3l-.7 2.2 2.3-.7A5.5 5.5 0 1 0 8 2.5z"/></svg></i><div>Chats<small>Orders and decisions</small></div></div>
          <div class="chip"><i><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="1.5"/><circle cx="6" cy="7" r="1.6"/><path d="M3.8 10.8c.4-1.1 1.2-1.7 2.2-1.7s1.8.6 2.2 1.7M10 6.3h2.5M10 8.8h2.5"/></svg></i><div>CRM<small>Customer data</small></div></div>
          <div class="chip"><i><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3.5" width="12" height="9" rx="1.5"/><path d="M2.5 4.8 8 9l5.5-4.2"/></svg></i><div>Email<small>Manual follow-up</small></div></div>
          <div class="chip wide"><i><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="5" r="2.2"/><path d="M3.5 13.5c.6-2.3 2.4-3.5 4.5-3.5s3.9 1.2 4.5 3.5"/></svg></i><div>People<small>People dependency</small></div></div>
        </div>
        <svg class="links" viewBox="0 0 400 64" aria-hidden="true">
          <path id="lp" d="M60,4 C60,44 200,44 200,52 M200,4 C200,40 200,44 200,52 M340,4 C340,44 200,44 200,52" fill="none" stroke="#2758D9" stroke-width="1.6" stroke-dasharray="300" stroke-dashoffset="300">
            <animate attributeName="stroke-dashoffset" from="300" to="0" dur="2.2s" fill="freeze" begin="0.4s"/>
          </path>
          <circle cx="200" cy="54" r="4" fill="#111318"/>
        </svg>
        <div class="core"><div><span>NEXT WRLD · SYSTEM</span><b>Your operation, centralized</b></div><div style="font-family:var(--mono);font-size:11px;background:#DCE6FF;color:#2758D9;padding:8px 12px;border-radius:8px">CONNECTED ✓</div></div>
        <div class="out">
          <div>Processes<span>defined</span></div><div>Data<span>available</span></div><div>Team<span>coordinated</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section data-od-id="problema" style="padding-top:40px">
    <div class="wrap">
      <div class="prob-head" data-reveal>
        <p class="eyebrow">When operations fall behind</p>
        <h2>Your company may have grown faster than the way it operates.</h2>
        <p class="lead">What worked with ten clients, a small team or few operations can become a limitation as the business grows.</p>
        <p class="lead" style="margin-top:12px;max-width:68ch">Your company’s day-to-day includes managing clients, information, payments, tasks, inventory, reports and decisions.</p>
      </div>
      <div class="plist" data-reveal>
        <div class="prow"><span class="n">01</span><h3>Excel became the system</h3><p>Critical information lives in increasingly complex sheets, hard to maintain and dependent on whoever created them.</p><span class="tag">SPREADSHEETS</span></div>
        <div class="prow"><span class="n">02</span><h3>WhatsApp is part of the process</h3><p>Orders, decisions and important information end up scattered across chats and people.</p><span class="tag">CHATS</span></div>
        <div class="prow"><span class="n">03</span><h3>Tools are not connected</h3><p>The team copies information from one system to another to keep operations running.</p><span class="tag">SYSTEMS</span></div>
        <div class="prow"><span class="n">04</span><h3>Too many repetitive tasks</h3><p>Admin processes consume hours every week even though they always follow the same rules.</p><span class="tag">TIME</span></div>
        <div class="prow"><span class="n">05</span><h3>Some people can’t be missing</h3><p>Part of the operation depends on knowledge that exists only in someone’s head.</p><span class="tag">RISK</span></div>
        <div class="prow"><span class="n">06</span><h3>Getting information costs too much</h3><p>A simple answer requires searching, consolidating and validating data from different places.</p><span class="tag">DATA</span></div>
      </div>
    </div>
  </section>

  <!-- COST -->
  <section class="dark on-dark" data-od-id="costo">
    <div class="wrap">
      <div data-reveal><p class="eyebrow">The cost of staying the same</p>
      <h2 style="margin:18px 0;max-width:20ch">It costs more every time to keep everything running.</h2></div>
      <div class="cost-flow" data-reveal>
        <div class="cf-row"><span>More clients</span><i>→</i><em>more administration.</em></div>
        <div class="cf-row"><span>More people</span><i>→</i><em>more coordination.</em></div>
        <div class="cf-row"><span>More tools</span><i>→</i><em>more scattered information.</em></div>
        <div class="cf-row"><span>More volume</span><i>→</i><em>more room for error.</em></div>
      </div>
      <p class="cost-close" data-reveal>Growth starts increasing complexity <em>faster than the ability to manage it.</em></p>
    </div>
  </section>

  <!-- BETTER WAY -->
  <div class="bridge"><div class="wrap"><div class="bridge-inner" data-reveal data-od-id="mejor-forma">
    <p class="eyebrow">A better way to operate</p>
    <h2 style="margin:18px 0;max-width:20ch">Growing shouldn’t mean doing more manual work.</h2>
    <p class="lead" style="max-width:68ch">When your company grows, tools that used to work can start falling short. You don’t always need to replace them: sometimes it is enough to connect what you already use, automate tasks or build a solution for a specific process.</p>
    <div class="ba">
      <div class="ba-col ba-before"><h4>BEFORE · MANUAL WORK</h4><ul><li>Manual processes</li><li>Scattered information</li><li>Isolated tools</li><li>People dependency</li><li>Manual reporting</li></ul></div>
      <div class="ba-mid">→</div>
      <div class="ba-col ba-after"><h4>AFTER · CONNECTED PROCESSES</h4><ul><li>Defined processes</li><li>Centralized information</li><li>Connected systems</li><li>Automation</li><li>Available data</li></ul></div>
    </div>
  </div></div></div>

  <!-- CAPABILITIES -->
  <section id="capacidades" data-od-id="capacidades">
    <div class="wrap">
      <div data-reveal><p class="eyebrow">What we can build</p>
      <h2 style="margin:18px 0">Technology designed around how your company works.</h2>
      <p class="lead" style="max-width:70ch">Sometimes you need to improve a process. Other times, connect the tools you already use. And other times, build a complete system. The solution depends on the problem.</p></div>
      <div class="cap-grid" data-reveal>
        <div class="cap" id="software-a-medida"><svg class="dg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="10" y="30" width="28" height="9" rx="2"/><rect x="10" y="19" width="28" height="9" rx="2"/><rect x="10" y="8" width="28" height="9" rx="2"/></svg><span class="num">01 / SOFTWARE</span><h3>Custom software</h3><p>We build software when existing tools no longer fit how your company works.</p><ul><li>internal platforms</li><li>portals</li><li>backoffices</li></ul><a href="/en/services/#software-a-medida">Explore custom software →</a></div>
        <div class="cap" id="sistemas-de-gestion"><svg class="dg" viewBox="0 0 48 48" fill="none" stroke-width="2" aria-hidden="true"><g stroke="#C2D1EB"><path d="M24 18V8M24 40v-10M18 24H8M40 24H30"/></g><rect x="18" y="18" width="12" height="12" rx="2" stroke="currentColor"/><circle cx="24" cy="6" r="2.5" stroke="currentColor"/><circle cx="24" cy="42" r="2.5" stroke="currentColor"/><circle cx="6" cy="24" r="2.5" stroke="currentColor"/><circle cx="42" cy="24" r="2.5" stroke="currentColor"/></svg><span class="num">02 / MANAGEMENT</span><h3>Management systems</h3><p>We centralize processes, information and reports so you can manage processes and information from a single place.</p><ul><li>operations</li><li>clients</li><li>inventory</li><li>reports</li></ul><a href="/en/services/#sistemas-de-gestion">Explore management systems →</a></div>
        <div class="cap" id="automatizacion-e-integraciones"><svg class="dg" viewBox="0 0 48 48" fill="none" stroke-width="2" aria-hidden="true"><circle cx="9" cy="24" r="4" stroke="#C2D1EB"/><circle cx="39" cy="24" r="4" stroke="currentColor"/><path d="M15 24h18m0 0-4-4m4 4-4 4" stroke="currentColor"/></svg><span class="num">03 / AUTOMATION</span><h3>Automation and integrations</h3><p>We connect the tools you already use and automate the repetitive tasks your team does today.</p><ul><li>syncing</li><li>workflows</li><li>integrations</li></ul><a href="/en/services/#automatizacion-e-integraciones">Explore automation →</a></div>
      </div>
      <div class="ai-strip" data-reveal><span style="font-size:20px">✦</span><p><b>We use AI only when it can improve a concrete task:</b> analyzing information, classifying data, finding answers or assisting your team.</p></div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="process" id="proceso" data-od-id="proceso">
    <div class="wrap">
      <div data-reveal><p class="eyebrow">How we work</p>
      <h2 style="margin:18px 0;max-width:22ch">From understanding the problem to building something that works in real use.</h2>
      <p class="lead">We don’t start by building features. First we understand the problem and then we decide what is worth solving.</p>
        <p class="t-hint">Explore each stage</p></div>
      <div class="tline" data-reveal>
        <div class="tbar"><div class="tprog" id="tprog"></div></div>
        <div class="tnodes" id="tnodes">
          <button class="tnode active" data-i="0"><span class="pt"></span><span class="pn">01 · DISCOVER</span><span class="pq">What is happening?</span></button>
          <button class="tnode" data-i="1"><span class="pt"></span><span class="pn">02 · SHAPE</span><span class="pq">What is worth it?</span></button>
          <button class="tnode" data-i="2"><span class="pt"></span><span class="pn">03 · BUILD</span><span class="pq">We turn direction into product.</span></button>
          <button class="tnode" data-i="3"><span class="pt"></span><span class="pn">04 · LAUNCH</span><span class="pq">Software lives with the business.</span></button>
          <button class="tnode" data-i="4"><span class="pt"></span><span class="pn">05 · EVOLVE</span><span class="pq">It grows with your operation.</span></button>
        </div>
        <div class="pane" id="pane">
          <div><div class="pk" id="pk">01 / DISCOVER</div><blockquote id="pq">What is happening?</blockquote><p id="pc">We understand how your team works today, what the business wants to achieve, what is generating unnecessary work and what depends on manual work.</p></div>
          <div class="res"><b id="plabel">Outcome 01</b><span id="pr">Clear problem and context.</span></div>
        </div>
        <div class="m-steps" id="mSteps"></div>
        <p class="pnote">The process can adapt to the size and complexity of each project. Not everyone needs to start from scratch.</p>
        <a class="t-next" href={calendarUrl} target="_blank" rel="noopener" data-od-id="proceso-diagnostico">Shall we start from a concrete problem? Book a diagnostic →</a>
      </div>
    </div>
  </section>

  <!-- AION -->
  <section class="aion on-dark" id="casos" data-od-id="aion">
    <div class="wrap aion-grid">
      <div data-reveal>
        <p class="eyebrow">Featured case · Own product</p>
        <span class="aion-mark">AION / WELLNESS</span>
        <h2>A gym’s daily operation, connected.</h2>
        <p class="lead">Members, memberships, payments, access and cash share the same operational journey. AION brings them together in a product designed for the daily work of fitness centers.</p>
        <p class="ownline">The case follows how we moved from fragmented processes to a shared model, a front-desk experience and a technical base ready to evolve.</p>
        <div class="cta-row"><a class="btn btn-a" href="/en/case-studies/aion-wellness/" data-od-id="aion-primary">Explore the AION case</a><a class="btn btn-s" href="https://www.aionwellness.pro/" target="_blank" rel="noopener">Visit the product ↗</a></div>
      </div>
      <div class="aion-product" data-reveal data-od-id="aion-ui"><AionProductUI locale="en" view="dashboard" compact /></div>
    </div>
  </section>

  <!-- MORE EVIDENCE -->
  <section id="casos-mas" data-od-id="casos-mas" style="padding-top:184px;padding-bottom:56px">
    <div class="wrap">
      <div data-reveal><p class="eyebrow">Real work</p><h2 style="margin:18px 0;max-width:24ch">We understand before building, whatever the business.</h2></div>
      <div class="cases" data-reveal>
        <div class="case"><span class="who">JFHP · PLATFORM MODERNIZATION</span><h3>Three years evolving a global system without stopping operations.</h3><p>Backend, data, web and mobile modernized in layers for a platform with 14K+ accounts, multiple languages, permissions and regional contexts.</p><a href="/en/case-studies/jfhp/">Explore the JFHP case →</a></div>
        <div class="case"><span class="who">INMOCRM · PROPTECH PRODUCT</span><h3>From fragmented operations to a connected real estate system.</h3><p>PropTech platform designed and built by Next Wrld to centralize properties, leads, visits, tasks and commercial activity.</p><a href="/en/case-studies/inmocrm/">View case →</a></div>
        <div class="case"><span class="who">AUTOMATIONS</span><h3>Repetitive tasks turned into automatic processes.</h3><p>We connect tools and automate repetitive tasks to reduce manual information moves.</p><a href="/en/services/#automatizacion-e-integraciones">Explore automations →</a></div>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section id="nosotros" data-od-id="por-que" style="padding-top:70px;padding-bottom:70px">
    <div class="wrap">
      <div data-reveal><p class="eyebrow">Why Next Wrld</p><h2 style="margin:18px 0;max-width:24ch">We start from what the business needs to achieve.</h2></div>
      <div class="why-grid" data-reveal>
        <div class="why"><h3>Judgment before code</h3><p>Deciding what not to build is part of the work.</p></div>
        <div class="why"><h3>Business + technology</h3><p>We connect operational goals with product, design and engineering decisions.</p></div>
        <div class="why"><h3>Quality beyond “it works”</h3><p>Product, experience, architecture and operations are solved together.</p></div>
        <div class="why"><h3>Built to evolve</h3><p>We build considering what will happen when more users, processes and needs arrive.</p></div>
      </div>
      <p class="anti" data-reveal>We are not a feature factory.</p>
    </div>
  </section>

  <!-- DIAGNOSIS -->
  <section id="diagnostico" data-od-id="diagnostico">
    <div class="wrap">
      <div data-reveal><p class="eyebrow">Operational diagnostic</p><h2 style="margin:18px 0;max-width:24ch">Before deciding what to build, let’s understand what is slowing your operation.</h2>
      <p class="lead" style="max-width:70ch">In a 30–45 minute conversation we review a concrete process in your company, identify what is generating unnecessary work, delays or dependency, and evaluate which opportunities could be solved with software, automation or integrations.</p></div>
      <div class="diag-grid">
        <div data-reveal>
          <div class="facts">
            <div><b>30–45 min</b><span>Conversation with Next Wrld.</span></div>
            <div><b>No cost</b><span>The initial diagnostic is free.</span></div>
            <div><b>Focused</b><span>It is not a services demo.</span></div>
          </div>
          <div class="diag-cta">
            <a class="btn btn-p" href={calendarUrl} target="_blank" rel="noopener" data-od-id="diag-primary">Book an operational diagnostic</a>
            <a class="btn btn-s" href={whatsappUrl('en', 'full')} target="_blank" rel="noopener" data-od-id="diag-whatsapp">Chat on WhatsApp</a>
          </div>
          <p class="micro">With no obligation to hire a project. · First: name, company, email and which part of your operation you want to improve. Then: you pick a time.</p>
        </div>
        <div class="doc" data-reveal data-od-id="diagnostico-entregable">
          <div class="doc-head"><b>Diagnostic · deliverable</b><span>PDF · 2 PAGES</span></div>
          <ol>
            <li><span class="dn">01</span><div><b>Current situation</b><p>How the process works today.</p></div></li>
            <li><span class="dn">02</span><div><b>Problems and blockers</b><p>What is generating unnecessary work, delays or dependency.</p></div></li>
            <li><span class="dn">03</span><div><b>Impact</b><p>How it affects the business.</p></div></li>
            <li><span class="dn">04</span><div><b>Opportunities</b><p>What could be simplified, connected or automated.</p></div></li>
            <li><span class="dn">05</span><div><b>Priorities</b><p>What would be best to address first.</p></div></li>
            <li><span class="dn">06</span><div><b>Initial proposal</b><p>What kind of solution could make sense.</p></div></li>
            <li><span class="dn">07</span><div><b>Next steps</b><p>What we recommend doing next.</p></div></li>
          </ol>
          <p style="padding:0 26px 24px;font-size:14px;color:var(--muted)">After the conversation you receive a diagnostic.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" data-od-id="faq" style="padding-top:20px">
    <div class="wrap">
      <div style="text-align:center" data-reveal><p class="eyebrow" style="justify-content:center">Common questions</p><h2 style="margin-top:14px">Questions before starting.</h2></div>
      <div class="faq" data-reveal>
        <details open><summary>How do I know if I need custom software? <span>+</span></summary><p>It makes sense to evaluate it when your company’s important processes no longer fit well into available tools, require too much manual work or need specific adaptations to work.</p></details>
        <details><summary>Do I have to replace the tools I already use? <span>+</span></summary><p>Not necessarily. Often the best solution is integrating or automating existing tools. Building something new only makes sense when it brings a clear benefit.</p></details>
        <details><summary>Can we start with a single process? <span>+</span></summary><p>Yes. In fact, it is often better to start from a concrete problem, measure the impact and evolve from there.</p></details>
        <details><summary>How long does a project take? <span>+</span></summary><p>It depends on the scope. A one-off automation can be solved in weeks, while a complete system can require several months. The initial diagnostic lets us understand which scenario applies.</p></details>
        <details><summary>How is pricing defined? <span>+</span></summary><p>By scope, complexity, integrations and uncertainty level. When the project requires deeper definition, we can run a Discovery stage before quoting the full build.</p></details>
        <details><summary>Does the software belong to my company? <span>+</span></summary><p>Yes. In custom software projects, the product developed for your company remains under the ownership conditions agreed from the start of the project.</p></details>
        <details><summary>What happens after launch? <span>+</span></summary><p>We can keep working on improvements, new automations, integrations and system evolution as operations change.</p></details>
        <details><summary>Where do you use artificial intelligence? <span>+</span></summary><p>We use it when it improves a concrete task: analyzing information, classifying data, assisting users, searching knowledge or automating decisions. We don’t add AI just to say a product has AI.</p></details>
      </div>
    </div>
  </section>

  <!-- FINAL -->
  <section class="final on-dark" data-od-id="cta-final">
    <div class="wrap" data-reveal>
      <p class="eyebrow" style="justify-content:center">Operational diagnostic</p>
      <h2>Your operation already works. Let’s make it easier to grow.</h2>
      <p>Tell us how you work today and let’s see where it makes sense to simplify, connect or build.</p>
      <div class="cta-row" style="justify-content:center"><a class="btn btn-a" href={calendarUrl} target="_blank" rel="noopener" data-od-id="final-primary">Analyze my operation</a><a class="btn btn-s" style="border-color:rgba(255,255,255,.45);color:#fff" href={whatsappUrl('en', 'full')} target="_blank" rel="noopener">Chat on WhatsApp</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { font-size: clamp(40px, 5.4vw, 76px); }
  h2 { font-size: clamp(30px, 3.6vw, 52px); }
  .serif { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; }
  .on-dark .eyebrow { color: #9dbcfb; }
  .on-dark .eyebrow::before { background: var(--accent); }
  .on-dark .lead { color: #a8b0b8; }
  section { scroll-margin-top: 80px; padding: 128px 0; }
  section[data-od-id='problema'],
  section[data-od-id='por-que'] { background: var(--surface-gray); }
  section[data-od-id='diagnostico'] { background: var(--surface-blue); }
  .btn-p:hover { background: #1f49b4; transform: translateY(-1px); box-shadow: 0 12px 28px rgba(10, 78, 220, 0.35); }
  .btn-s:hover { border-color: var(--accent); background: #dce6ff; }
  .btn-a { background: var(--accent); color: #fff; }
  .btn-a:hover { background: #1f49b4; }
  /* hero */
  .hero { padding: 84px 0 90px; position: relative; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
  .hero h1 { margin: 22px 0 20px; }
  .hero-sub { font-size: 18px; max-width: 52ch; }
  .hero-line { margin-top: 18px; font-family: var(--serif); font-style: italic; font-size: 21px; }
  .cta-row { display: flex; gap: 14px; margin-top: 30px; flex-wrap: wrap; }
  .hero .cta-row .btn { flex: 1 1 0; min-width: 0; }
  .micro { font-family: var(--mono); font-size: 12.5px; color: var(--muted); margin-top: 14px; }
  /* hero visual */
  .sys { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 22px; box-shadow: var(--shadow-soft); transform: scale(1.02); }
  .sys-head { display: flex; justify-content: space-between; align-items: center; font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; color: var(--muted); margin-bottom: 14px; }
  .dotlive { display: inline-flex; align-items: center; gap: 7px; }
