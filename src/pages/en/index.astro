---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AionProductUI from '../../components/cases/AionProductUI.astro';
---

<BaseLayout
  locale="en"
  routeKey="home"
  canonicalPath="/en/"
  title="Custom software for companies | Next Wrld"
  description="We design custom software for companies that need fewer manual processes, connected tools, and more operational control."
>
  <section class="hero" data-od-id="hero">
    <div class="wrap hero-grid">
      <div data-reveal>
        <p class="eyebrow">Software for growing operations</p>
        <h1>Your company shouldn’t grow by multiplying manual work.</h1>
        <p class="lead hero-sub">We design software to centralize processes, connect tools and automate work that today depends on spreadsheets, messages and manual tasks.</p>
        <div class="cta-row">
          <a class="btn btn-p" href="/en/diagnostic/" data-od-id="hero-primary">Analyze my operation</a>
          <a class="btn btn-s" href="/en/how-we-work/" data-od-id="hero-secondary">How we work</a>
        </div>
        <p class="micro">Free diagnostic · 30–45 minutes</p>
      </div>
      <div class="sys" data-reveal aria-label="From scattered tools to connected operations">
        <div class="sys-head"><span>SCATTERED TOOLS</span><span class="dotlive"><span class="pulse"></span>LIVE</span></div>
        <div class="frag">
          <div class="chip"><i><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2.5" width="12" height="11" rx="1.5"/><path d="M2 6h12M2 9.5h12M7 2.5v11"/></svg></i><div>Excel<small>Critical spreadsheets</small></div></div>
          <div class="chip"><i><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5a5.5 5.5 0 0 0-5.5 5.5c0 1.2.4 2.4 1.1 3.3l-.7 2.2 2.3-.7A5.5 5.5 0 1 0 8 2.5z"/></svg></i><div>Chats<small>Orders and decisions</small></div></div>
          <div class="chip"><i><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="1.5"/><circle cx="6" cy="7" r="1.6"/><path d="M3.8 10.8c.4-1.1 1.2-1.7 2.2-1.7s1.8.6 2.2 1.7M10 6.3h2.5M10 8.8h2.5"/></svg></i><div>CRM<small>Customer data</small></div></div>
          <div class="chip"><i><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3.5" width="12" height="9" rx="1.5"/><path d="M2.5 4.8 8 9l5.5-4.2"/></svg></i><div>Email<small>Manual follow-up</small></div></div>
        </div>
        <svg class="links" viewBox="0 0 400 64" aria-hidden="true">
          <path d="M60,4 C60,44 200,44 200,52 M200,4 C200,40 200,44 200,52 M340,4 C340,44 200,44 200,52" fill="none" stroke="#2758D9" stroke-width="1.6" stroke-dasharray="300" stroke-dashoffset="300">
            <animate attributeName="stroke-dashoffset" from="300" to="0" dur="2.2s" fill="freeze" begin="0.4s"/>
          </path>
          <circle cx="200" cy="54" r="4" fill="#111318"/>
        </svg>
        <div class="core"><div><span>NEXT WRLD · SYSTEM</span><b>Your operation, centralized</b></div><div class="core-ok">CONNECTED ✓</div></div>
        <div class="out">
          <div>Processes<span>defined</span></div><div>Data<span>available</span></div><div>Team<span>coordinated</span></div>
        </div>
      </div>
    </div>
  </section>

  <section data-od-id="problema" class="prob">
    <div class="wrap">
      <div data-reveal class="prob-head">
        <p class="eyebrow">When operations fall behind</p>
        <h2>Your company may have grown faster than the way it operates.</h2>
        <p class="lead">What worked with ten clients or few operations can become a limitation as the business grows.</p>
      </div>
      <div class="pgrid" data-reveal>
        <div class="pcard"><svg class="pc-ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="7" y="7" width="18" height="18" rx="2"/><path d="M7 12h18M7 17h18M12 7v18"/></svg><span class="pc-num">01</span><h3>Spreadsheets turned into systems</h3><p>Critical information depends on files increasingly hard to maintain and on whoever created them.</p></div>
        <div class="pcard"><svg class="pc-ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M16 6a9 9 0 0 0-9 9c0 2 .6 3.9 1.8 5.4l-1.1 3.6 3.7-1.1A9 9 0 1 0 16 6z"/></svg><span class="pc-num">02</span><h3>Processes that live in WhatsApp</h3><p>Decisions and important information stay scattered across chats and people, with no traceability.</p></div>
        <div class="pcard"><svg class="pc-ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="11" y="11" width="10" height="10" rx="2"/><circle cx="16" cy="6" r="2"/><circle cx="16" cy="26" r="2"/><circle cx="6" cy="16" r="2"/><circle cx="26" cy="16" r="2"/><path d="M16 8v3M16 21v3M8 16H11M21 16h3"/></svg><span class="pc-num">03</span><h3>Disconnected tools</h3><p>The team moves information manually between systems to keep operations running.</p></div>
        <div class="pcard"><svg class="pc-ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="16" cy="11" r="3.5"/><path d="M7 24c1-3.5 4-5.5 9-5.5s8 2 9 5.5"/></svg><span class="pc-num">04</span><h3>People who can’t be missing</h3><p>Part of the operation depends on knowledge not yet inside a system or process.</p></div>
      </div>
      <p class="prob-bridge" data-reveal>More growth shouldn’t mean more administration.</p>
      <div class="transform" data-reveal>
        <div class="tr-row"><span>Manual</span><i>→</i><b>Automated</b></div>
        <div class="tr-row"><span>Scattered</span><i>→</i><b>Centralized</b></div>
        <div class="tr-row"><span>Disconnected</span><i>→</i><b>Integrated</b></div>
        <div class="tr-row"><span>Dependent</span><i>→</i><b>Repeatable</b></div>
      </div>
      <p class="transform-close" data-reveal>Technology should reduce complexity, not add another tool to manage.</p>
    </div>
  </section>

  <section id="capacidades" data-od-id="capacidades">
    <div class="wrap">
      <div data-reveal>
        <p class="eyebrow">What we solve</p>
        <h2>Technology designed around how your company works.</h2>
        <p class="lead" style="max-width:70ch">Sometimes you need to improve a process. Other times, connect tools you already use. And other times, build a complete system. The solution depends on the problem.</p>
      </div>
      <div class="cap-grid" data-reveal>
        <div class="cap">
          <svg class="cap-ic" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="10" y="30" width="28" height="9" rx="2"/><rect x="10" y="19" width="28" height="9" rx="2"/><rect x="10" y="8" width="28" height="9" rx="2"/></svg>
          <span class="num">01 / SOFTWARE</span><h3>Custom software</h3>
          <p>Systems built around processes that generic tools don’t solve well.</p>
          <a href="/en/services/#software-a-medida">Explore custom software →</a>
        </div>
        <div class="cap">
          <svg class="cap-ic" viewBox="0 0 48 48" fill="none" stroke-width="1.8" aria-hidden="true"><g stroke="#C2D1EB"><path d="M24 18V8M24 40v-10M18 24H8M40 24H30"/></g><rect x="18" y="18" width="12" height="12" rx="2" stroke="currentColor"/><circle cx="24" cy="6" r="2.5" stroke="currentColor"/><circle cx="24" cy="42" r="2.5" stroke="currentColor"/><circle cx="6" cy="24" r="2.5" stroke="currentColor"/><circle cx="42" cy="24" r="2.5" stroke="currentColor"/></svg>
          <span class="num">02 / MANAGEMENT</span><h3>Management systems</h3>
          <p>We centralize information and processes so operations can be managed from a clearer place.</p>
          <a href="/en/services/#sistemas-de-gestion">Explore management systems →</a>
        </div>
        <div class="cap">
          <svg class="cap-ic" viewBox="0 0 48 48" fill="none" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="24" r="4" stroke="#C2D1EB"/><circle cx="39" cy="24" r="4" stroke="currentColor"/><path d="M15 24h18m0 0-4-4m4 4-4 4" stroke="currentColor"/></svg>
          <span class="num">03 / AUTOMATION</span><h3>Automation and integrations</h3>
          <p>We connect tools and eliminate tasks that don’t need constant manual intervention.</p>
          <a href="/en/services/#automatizacion-e-integraciones">Explore automation →</a>
        </div>
      </div>
      <p class="ai-note" data-reveal>AI is part of the solution when it improves a concrete task, not as a selling point on its own.</p>
    </div>
  </section>

  <section class="process" id="proceso" data-od-id="proceso">
    <div class="wrap">
      <div data-reveal>
        <p class="eyebrow">How we work</p>
        <h2>From understanding the problem to building something that works in real use.</h2>
        <p class="lead" style="max-width:62ch;margin-top:14px">We don’t start by building. First we understand the problem, then decide what’s worth solving. Each stage has a clear purpose and adapts to your project’s size.</p>
        <p class="t-hint">Explore each stage</p>
      </div>
      <div class="tline" data-reveal>
        <div class="tbar"><div class="tprog" id="tprog"></div></div>
        <div class="tnodes" id="tnodes">
          <button class="tnode active" data-i="0"><span class="pt"></span><span class="pn">01 · DISCOVER</span><span class="pq">How it works today.</span></button>
          <button class="tnode" data-i="1"><span class="pt"></span><span class="pn">02 · SHAPE</span><span class="pq">What’s worth solving.</span></button>
          <button class="tnode" data-i="2"><span class="pt"></span><span class="pn">03 · BUILD</span><span class="pq">Turn direction into product.</span></button>
          <button class="tnode" data-i="3"><span class="pt"></span><span class="pn">04 · LAUNCH</span><span class="pq">Bring it to real operations.</span></button>
          <button class="tnode" data-i="4"><span class="pt"></span><span class="pn">05 · EVOLVE</span><span class="pq">Adapt as the business changes.</span></button>
        </div>
        <div class="pane" id="pane">
          <div><div class="pk" id="pk">01 / DISCOVER — Understand</div><blockquote id="pq">How it works today.</blockquote><p id="pc">We talk to your team, map the real flow, the tools you use and where manual work creates friction, delays or dependency.</p></div>
          <div class="res"><b id="plabel">Outcome 01</b><span id="pr">Clear problem and context.</span></div>
        </div>
        <div class="m-steps" id="mSteps">
          <div class="m-step"><div class="pk">01 / DISCOVER — Understand</div><blockquote>How it works today.</blockquote><p>We talk to your team, map the real flow, the tools you use and where manual work creates friction, delays or dependency.</p><div class="m-out">Outcome 01<span>Clear problem and context.</span></div></div>
          <div class="m-step"><div class="pk">02 / SHAPE — Decide</div><blockquote>What’s worth solving.</blockquote><p>We turn learnings into priorities, initial scope and a clear technical direction before investing in build.</p><div class="m-out">Outcome 02<span>Direction and priorities set.</span></div></div>
          <div class="m-step"><div class="pk">03 / BUILD — Build</div><blockquote>Turn direction into product.</blockquote><p>We design and develop the system, integrations and automations iteratively, validating with real use.</p><div class="m-out">Outcome 03<span>Software ready for operations.</span></div></div>
          <div class="m-step"><div class="pk">04 / LAUNCH — Integrate</div><blockquote>Bring it to real operations.</blockquote><p>We connect data and tools, migrate information and support the team so the system lives with the business.</p><div class="m-out">Outcome 04<span>System in use.</span></div></div>
          <div class="m-step"><div class="pk">05 / EVOLVE — Improve</div><blockquote>Adapt as the business changes.</blockquote><p>We measure, learn and evolve the system as more users, processes and needs arise.</p><div class="m-out">Outcome 05<span>Product that grows with you.</span></div></div>
        </div>
        <p class="pnote">The process adapts to each project’s size and complexity. Not everyone needs to start from scratch.</p>
        <a class="t-next" href="/en/how-we-work/">Explore our process →</a>
      </div>
    </div>
  </section>

  <section class="aion on-dark" id="casos" data-od-id="aion">
    <div class="wrap">
      <div data-reveal>
        <p class="eyebrow">Featured case</p>
        <span class="aion-mark">A PRODUCT BY NEXT WRLD</span>
        <h2>A product designed around the daily operation of fitness businesses.</h2>
        <p class="lead">AION centralizes memberships, plans, payments, members and cash closings inside a platform created to simplify management of fitness and sports centers.</p>
        <div class="cta-row"><a class="btn btn-a" href="/en/case-studies/aion-wellness/">Explore the AION case</a><a class="btn btn-s btn-s--dark" href="https://www.aionwellness.pro/" target="_blank" rel="noopener">Visit the product ↗</a></div>
      </div>
      <div class="aion-product" data-reveal><AionProductUI locale="en" view="dashboard" compact /></div>
    </div>
  </section>

  <section id="casos-mas" data-od-id="casos-mas">
    <div class="wrap">
      <div data-reveal><p class="eyebrow">Real work</p><h2 style="max-width:22ch">We understand before building, whatever the business.</h2></div>
      <div class="cases" data-reveal>
        <div class="case">
          <svg class="case-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 12h8M12 8v8"/></svg><span class="who">JFHP · CENTRALIZED PLATFORM</span>
          <h3>From distributed admin processes to a centralized platform.</h3>
          <p>Evolution of a real platform used by thousands of accounts, with reporting, permissions, inventory, training and different regional contexts.</p>
          <a href="/en/case-studies/jfhp/">Explore the JFHP case →</a>
        </div>
        <div class="case">
          <svg class="case-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 13l8-7 8 7v7a1 1 0 0 1-1 1h-3V14H8v7H5a1 1 0 0 1-1-1z"/></svg><span class="who">INMOCRM · PROPTECH</span>
          <h3>From operational research to a PropTech MVP.</h3>
          <p>Research, product definition and MVP build focused on centralizing real estate business processes.</p>
          <a href="/en/case-studies/inmocrm/">View case →</a>
        </div>
      </div>
    </div>
  </section>

  <section id="diagnostico" data-od-id="diagnostico" class="diag-sec">
    <div class="wrap">
      <div data-reveal>
        <p class="eyebrow">Operational diagnostic</p>
        <h2>Before deciding what to build, let’s understand what is slowing your operation.</h2>
        <p class="lead" style="max-width:70ch">We review a concrete process in your operation to identify frictions and improvement opportunities.</p>
      </div>
      <div class="diag-grid">
        <div data-reveal>
          <div class="facts">
            <div><b>30–45 minutes</b><span>Free</span></div>
            <div><b>No obligation</b><span>to hire</span></div>
            <div><b>Focused</b><span>on one concrete process</span></div>
          </div>
          <a class="btn btn-p" href="/en/diagnostic/" style="margin-top:28px">Analyze my operation</a>
          <p class="micro">Free diagnostic · 30–45 minutes · No hiring obligation</p>
        </div>
        <div class="doc" data-reveal>
          <div class="doc-head"><b>Diagnostic · deliverable</b><span>PDF · 3–5 PAGES</span></div>
          <ol>
            <li><span class="dn">01</span><div><b>Current situation</b><p>How the process works today.</p></div></li>
            <li><span class="dn">02</span><div><b>Frictions</b><p>What causes unnecessary work or delays.</p></div></li>
            <li><span class="dn">03</span><div><b>Impact</b><p>How it affects the business.</p></div></li>
            <li><span class="dn">04</span><div><b>Opportunities</b><p>What could be simplified or automated.</p></div></li>
            <li><span class="dn">05</span><div><b>Priorities</b><p>What to address first.</p></div></li>
            <li><span class="dn">06</span><div><b>Initial proposal</b><p>What kind of solution could make sense.</p></div></li>
            <li><span class="dn">07</span><div><b>Next steps</b><p>What we recommend doing next.</p></div></li>
          </ol>
          <p class="doc-foot">3–5 page mini diagnostic after the conversation.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1{font-size:clamp(40px,5.4vw,76px);line-height:1.02;letter-spacing:-.03em}
  h2{font-size:clamp(30px,3.6vw,52px);line-height:1.08;letter-spacing:-.02em}
  section{scroll-margin-top:80px;padding:112px 0}
  .hero{padding:92px 0 84px}
  section.prob{background:var(--surface-gray)}
  .diag-sec{background:var(--surface-blue)}
  .on-dark .eyebrow{color:#9dbcfb}.on-dark .eyebrow::before{background:var(--accent)}
  .hero{padding:84px 0 72px}
  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
  .hero h1{margin:22px 0 16px}
  .hero-sub{font-size:18px;max-width:52ch}
  .cta-row{display:flex;gap:14px;margin-top:28px;flex-wrap:wrap}
  .micro{font-family:var(--mono);font-size:12.5px;color:var(--muted);margin-top:14px}
  .sys{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:22px;box-shadow:var(--shadow-soft)}
  .sys-head{display:flex;justify-content:space-between;align-items:center;font-family:var(--mono);font-size:11px;letter-spacing:.12em;color:var(--muted);margin-bottom:14px}
  .dotlive{display:inline-flex;align-items:center;gap:7px}
  .pulse{width:8px;height:8px;border-radius:50%;background:#2758d9;animation:pl 1.8s infinite}
  @keyframes pl{0%,100%{box-shadow:0 0 0 0 rgba(39,88,217,.4)}50%{box-shadow:0 0 0 7px rgba(39,88,217,0)}}
  .frag{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:6px}
  .chip{border:1px dashed #c2d1eb;border-radius:12px;padding:12px 14px;display:flex;align-items:center;gap:10px;font-size:13.5px;font-weight:600;background:#f7f8fa}
  .chip i{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:var(--bg);border:1px solid var(--border);flex:none;font-style:normal;font-size:14px}
  .chip small{display:block;font-weight:400;color:var(--muted);font-size:12px}
  .links{height:64px;display:block;width:100%}
  .core{border:1px solid var(--border);border-left:3px solid var(--accent);background:#fff;border-radius:12px;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px}
  .core b{font-family:var(--disp);font-size:15px}
  .core span{font-family:var(--mono);font-size:11px;opacity:.7;display:block;letter-spacing:.1em}
  .core-ok{font-family:var(--mono);font-size:11px;background:#DCE6FF;color:#2758D9;padding:8px 12px;border-radius:8px}
  .out{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:10px}
  .out div{background:#f7f8fa;border:1px solid var(--border);border-radius:var(--r-sm);padding:10px;font-size:12px;font-weight:600;text-align:center}
  .out span{display:block;font-family:var(--mono);font-weight:400;color:#2758d9;font-size:11px;margin-top:2px}
  .prob-head{max-width:860px}
  .prob-head h2{margin:18px 0}
  .pgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:40px}
  .pcard{background:#fff;border:1px solid var(--border);border-radius:16px;padding:26px}
  .pc-ic{width:32px;height:32px;color:var(--accent);display:block;margin-bottom:14px}
  .pc-num{font-family:var(--mono);font-size:12px;letter-spacing:.14em;color:var(--accent);font-weight:700}
  .pcard h3{font-family:var(--disp);font-size:21px;margin:8px 0 8px;letter-spacing:-.02em}
  .pcard p{color:var(--muted);font-size:15px;line-height:1.5}
  .prob-bridge{margin-top:40px;font-family:var(--disp);font-size:clamp(20px,2.4vw,28px);font-weight:600;text-align:center;letter-spacing:-.02em}
  .transform{margin-top:28px;border-top:1px solid var(--border);max-width:720px;margin-left:auto;margin-right:auto}
  .tr-row{display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:center;padding:18px 0;border-bottom:1px solid var(--border)}
  .tr-row span{font-family:var(--disp);font-size:18px;color:var(--muted);text-align:right}
  .tr-row i{font-style:normal;color:var(--accent);font-weight:700}
  .tr-row b{font-family:var(--disp);font-size:18px}
  .transform-close{margin-top:20px;text-align:center;color:var(--muted);font-size:15px}
  .cap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:48px;margin-top:48px;align-items:stretch}
  .cap{display:flex;flex-direction:column;padding-top:22px;border-top:2px solid var(--accent)}
  .cap-ic{width:40px;height:40px;color:var(--accent);display:block;margin-bottom:14px}
  .cap .num{font-family:var(--mono);font-size:12px;color:var(--accent);letter-spacing:.14em}
  .cap h3{font-family:var(--disp);font-size:24px;margin:10px 0}
  .cap p{color:var(--muted);font-size:15.5px;flex:1}
  .cap a{font-weight:600;font-size:14px;text-decoration:none;border-bottom:2px solid var(--accent);align-self:flex-start;margin-top:16px}
  .ai-note{margin-top:32px;color:var(--muted);font-size:14px;border-left:2px solid var(--border);padding-left:16px;max-width:70ch}
  .process{background:var(--surface-gray);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:84px 0}
  .process .lead{max-width:56ch}
  .tline{position:relative;margin-top:48px}
  .tbar{height:4px;background:var(--border);position:relative;border-radius:2px}
  .tprog{position:absolute;left:0;top:0;height:100%;background:var(--accent);width:0;border-radius:2px;transition:width .3s}
  .tnodes{display:grid;grid-template-columns:repeat(5,1fr);gap:18px;margin-top:-5px}
  .tnode{cursor:pointer;text-align:left;background:none;border:0;padding:0;display:block;font-family:inherit}
  .tnode .pt{position:relative;z-index:1;display:block;width:14px;height:14px;border-radius:50%;border:2px solid #c2d1eb;background:#fff;margin-bottom:16px;transition:background .2s,border-color .2s,transform .2s}
