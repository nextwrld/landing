  .article h3 { font-size: 21px; margin: 36px 0 4px; letter-spacing: -0.01em; line-height: 1.3; }
  .article .strong { font-family: var(--disp); font-weight: 600; font-size: 22px; letter-spacing: -0.01em; margin: 32px 0; }
  .cta { background: var(--surface-gray); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 88px 0; margin-bottom: 88px; }
  .cta h2 { font-size: clamp(30px, 4vw, 50px); margin: 18px 0; letter-spacing: -0.03em; line-height: 1.05; }
  .cta p { color: var(--muted); font-size: 17px; max-width: 56ch; }
  .cta-row { display: flex; gap: 14px; margin-top: 30px; flex-wrap: wrap; }
  .btn-p:hover { background: #1f49b4; transform: translateY(-1px); box-shadow: 0 12px 28px rgba(10, 78, 220, 0.35); }
  @media (max-width: 720px) {
