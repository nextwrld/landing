---
import type { Locale } from '../../i18n/config';
import { getChrome } from '../../i18n/ui';

interface Props {
  locale?: Locale;
  title: string;
  copy: string;
}

const { locale = 'es', title, copy } = Astro.props;
const chrome = getChrome(locale);
---

<section class="final" data-od-id="cta-final">
  <div class="wrap" data-reveal>
    <h2>{title}</h2>
    <p>{copy}</p>
    <div class="cta-row">
      <a
        class="btn btn-p"
        href="https://calendar.app.google/JQnkVUqK3FF5VSRU6"
        target="_blank"
        rel="noopener"
        data-od-id="final-primary"
      >
        {chrome.scheduleDiagnostic}
      </a>
      <a
        class="btn btn-s"
        href="https://wa.me/5491173678601?text=Hola%2C%20llegu%C3%A9%20desde%20Next%20Wrld."
        target="_blank"
        rel="noopener"
      >
        {chrome.whatsappLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .final {
    background: var(--navy);
    color: #fff;
    text-align: center;
    padding: 130px 0;
  }
  .cta-row {
    display: flex;
    gap: 14px;
    justify-content: center;
    margin-top: 30px;
    flex-wrap: wrap;
  }
</style>
