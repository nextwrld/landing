---
import { route } from '../../i18n/routes';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEs = locale === 'es';
---

<footer data-od-id="footer">
  <div class="wrap">
    <div class="fgrid">
      <div>
        <a class="logo" href={isEs ? '/' : '/en/'}>
          <img src="/assets/brand/logo.svg" alt="" width="34" height="34" loading="lazy" decoding="async" />
          Next Wrld<span>.</span>
        </a>
        <p class="tagline">
          {
            isEs
              ? 'Software a medida para empresas que necesitan operar con más claridad y menos trabajo manual.'
              : 'Custom software for companies that need clearer operations and less manual work.'
          }
        </p>
      </div>
      <div>
        <h5>{isEs ? 'SERVICIOS' : 'SERVICES'}</h5>
        <a href={`${route('services', locale)}#software-a-medida`}>{isEs ? 'Software a medida' : 'Custom software'}</a>
        <a href={`${route('services', locale)}#sistemas-de-gestion`}>{isEs ? 'Sistemas de gestión' : 'Management systems'}</a>
        <a href={`${route('services', locale)}#automatizacion-e-integraciones`}>{isEs ? 'Automatización' : 'Automation'}</a>
      </div>
      <div>
        <h5>{isEs ? 'EMPRESA' : 'COMPANY'}</h5>
        <a href={route('howWeWork', locale)}>{isEs ? 'Cómo trabajamos' : 'How we work'}</a>
        <a href={route('cases', locale)}>{isEs ? 'Casos' : 'Case studies'}</a>
        <a href={route('insights', locale)}>Insights</a>
        <a href={route('about', locale)}>{isEs ? 'Nosotros' : 'About'}</a>
      </div>
      <div>
        <h5>{isEs ? 'CONTACTO' : 'CONTACT'}</h5>
        <a
          href="https://calendar.app.google/JQnkVUqK3FF5VSRU6"
          target="_blank"
          rel="noopener"
        >
          {isEs ? 'Diagnóstico operativo' : 'Operational diagnostic'}
        </a>
        <a
          href="https://wa.me/5491173678601?text=Hola%2C%20llegu%C3%A9%20desde%20Next%20Wrld.%20Quiero%20conversar%20sobre%20un%20proceso%20de%20mi%20empresa%20que%20estamos%20buscando%20mejorar."
          target="_blank"
          rel="noopener"
        >
          WhatsApp
        </a>
        <a href="mailto:hola@nextwrld.com?subject=Diagn%C3%B3stico%20operativo">Email</a>
        <a href="https://linkedin.com/company/next-wrld" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://instagram.com/nextwrld.tech" target="_blank" rel="noopener">Instagram</a>
      </div>
    </div>
    <div class="legal">
      <span>© 2026 Next Wrld · ES / EN</span>
      <span>{isEs ? 'Privacidad · Términos · Aviso legal' : 'Privacy · Terms · Legal notice'}</span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 56px 0 32px;
    background: var(--bg);
  }
  .logo {
    font-family: var(--disp);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.02em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .logo span {
    color: var(--accent);
  }
  .logo img {
    display: block;
    flex: none;
  }
  footer .logo {
    font-size: 22px;
  }
  footer .logo img {
    width: 34px;
    height: 34px;
  }
  .tagline {
    color: var(--muted);
    font-size: 14.5px;
    margin-top: 12px;
    max-width: 32ch;
  }
  .fgrid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 32px;
  }
  .fgrid h5 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .fgrid a {
    display: block;
    text-decoration: none;
    font-size: 14.5px;
    padding: 5px 0;
    opacity: 0.92;
  }
  .fgrid a:hover {
    opacity: 1;
  }
  .legal {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
    font-size: 12.5px;
    color: var(--ink-soft);
    flex-wrap: wrap;
  }
  @media (max-width: 960px) {
    .fgrid {
      grid-template-columns: 1fr 1fr;
      gap: 28px 20px;
    }
    footer {
      padding: 48px 0 28px;
    }
    .legal {
      flex-direction: column;
      gap: 8px;
      margin-top: 28px;
    }
  }
</style>
