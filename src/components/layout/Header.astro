---
import { getNav, getChrome } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import type { RouteKey } from '../../i18n/routes';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  current: RouteKey;
  alternatePath: string;
}

const { locale, current, alternatePath } = Astro.props;
const nav = getNav(locale);
const chrome = getChrome(locale);
---

<header data-od-id="site-header">
  <div class="hbar">
    <a class="logo" href={locale === 'es' ? '/' : '/en/'}>
      <img src="/assets/brand/logo.svg" alt="" width="32" height="32" fetchpriority="high" decoding="async" />
      Next Wrld<span>.</span>
    </a>
    <nav class="desk" aria-label={locale === 'es' ? 'Principal' : 'Primary'}>
      {
        nav.map((item) => (
          <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="hright">
      <LanguageSwitcher locale={locale} alternatePath={alternatePath} />
      <a
        class="btn btn-p btn-sm"
        href="https://calendar.app.google/JQnkVUqK3FF5VSRU6"
        target="_blank"
        rel="noopener"
        data-od-id="nav-cta"
      >
        {chrome.diagnosticCta}
      </a>
      <button class="burger" id="burger" aria-label={chrome.openMenu}>☰</button>
    </div>
  </div>
  <div class="mmenu" id="mmenu">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <p>
      <LanguageSwitcher locale={locale} alternatePath={alternatePath} />
    </p>
    <a
      class="btn btn-p"
      href="https://calendar.app.google/JQnkVUqK3FF5VSRU6"
      target="_blank"
      rel="noopener"
    >
      {chrome.scheduleDiagnostic}
    </a>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(252, 252, 251, 0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .hbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 32px;
  }
  .logo {
    font-family: var(--disp);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.02em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .logo span {
    color: var(--accent);
  }
  .logo img {
    width: 32px;
    height: 32px;
    display: block;
    flex: none;
  }
  nav.desk {
    display: flex;
    gap: 30px;
    font-size: 14.5px;
    font-weight: 500;
  }
  nav.desk a {
    text-decoration: none;
    opacity: 0.75;
  }
  nav.desk a:hover,
  nav.desk a[aria-current='page'] {
    opacity: 1;
  }
  .hright {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .burger {
    display: none;
    background: none;
    border: 0;
    font-size: 24px;
    cursor: pointer;
  }
  .mmenu {
    display: none;
    border-top: 1px solid var(--border);
    padding: 20px 32px 28px;
    background: var(--bg);
  }
  .mmenu.open {
    display: block;
  }
  @media (max-width: 960px) {
    nav.desk,
    .hright .btn-sm {
      display: none;
    }
    .burger {
      display: block;
    }
  }
</style>
