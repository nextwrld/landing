---
// InmoCRM illustrative product compositions.
// Sample data is fictional and labeled as such. Visual scope mirrors the
// verified MVP: dashboard priorities, property record, pipeline, visits,
// public page. No private CRM data appears in the public view.
interface Props {
  locale: 'es' | 'en';
  view?: 'dashboard' | 'property' | 'pipeline' | 'visit' | 'public';
  compact?: boolean;
}

const { locale, view = 'dashboard', compact = false } = Astro.props;

const c = locale === 'es'
  ? {
      browserTitle: 'INMOCRM · OPERACIÓN COMERCIAL', sampleData: 'DATOS DE EJEMPLO',
      dashboard: 'Panel', properties: 'Propiedades', pipeline: 'Pipeline', visits: 'Visitas',
      tasks: 'Tareas', activity: 'Actividad', agency: 'Agencia Palermo Sur', activeOrg: 'Organización activa',
      dayContext: 'HOY · PRIORIDADES OPERATIVAS', attentionToday: 'Atención de hoy',
      noFollowUp: 'Leads sin seguimiento', incomplete: 'Propiedades incompletas',
      upcomingVisits: 'Próximas visitas', activeBlocked: 'Oportunidades activas y frenadas',
      illustrativeFigures: 'cifras ilustrativas', viewAll: 'Ver todo',
      followUpOverdue: 'Seguimiento vencido', missingPhotos: 'Faltan fotos de portada',
      scheduledToday: 'Programada para hoy', blockedNegotiation: 'Negociación detenida',
      recordTitle: 'FICHA DE PROPIEDAD', cover: 'Portada', quality: 'Calidad de ficha',
      qualityNote: 'Completa fotos y atributos para publicar con confianza.',
      attributes: 'Atributos', features: 'Características', owner: 'Propietario',
      responsible: 'Responsable', status: 'ESTADO', operation: 'OPERACIÓN', type: 'TIPO',
      aiAssist: 'Asistencia de IA', aiNote: 'La IA propone el texto. El equipo revisa y aprueba antes de guardar.',
      preview: 'Vista previa', approve: 'Aprobar y guardar', editFirst: 'Editar antes de aprobar',
      leadStages: 'Etapas del pipeline', perAgent: 'por responsable', history: 'Historial',
      nextFollowUp: 'Próximo seguimiento', outcome: 'Resultado', confirm: 'Confirmar visita',
      complete: 'Marcar realizada', publicPage: 'PÁGINA PÚBLICA', contactCta: 'Contactar por WhatsApp',
      views: 'visitas a la página', agencyInfo: 'Información de la agencia',
      privateNote: 'La página pública muestra solo información comercial. Los datos internos del CRM permanecen privados.',
    }
  : {
      browserTitle: 'INMOCRM · COMMERCIAL OPERATIONS', sampleData: 'SAMPLE DATA',
      dashboard: 'Dashboard', properties: 'Properties', pipeline: 'Pipeline', visits: 'Visits',
      tasks: 'Tasks', activity: 'Activity', agency: 'Palermo Sur Realty', activeOrg: 'Active organization',
      dayContext: 'TODAY · OPERATIONAL PRIORITIES', attentionToday: 'Needs attention today',
      noFollowUp: 'Leads without follow-up', incomplete: 'Incomplete properties',
      upcomingVisits: 'Upcoming visits', activeBlocked: 'Active and stalled opportunities',
      illustrativeFigures: 'illustrative figures', viewAll: 'View all',
      followUpOverdue: 'Follow-up overdue', missingPhotos: 'Missing cover photos',
      scheduledToday: 'Scheduled for today', blockedNegotiation: 'Negotiation stalled',
      recordTitle: 'PROPERTY RECORD', cover: 'Cover', quality: 'Listing quality',
      qualityNote: 'Complete photos and attributes before publishing with confidence.',
      attributes: 'Attributes', features: 'Features', owner: 'Owner',
      responsible: 'Agent in charge', status: 'STATUS', operation: 'OPERATION', type: 'TYPE',
      aiAssist: 'AI assistance', aiNote: 'AI drafts the copy. The team reviews and approves before saving.',
      preview: 'Preview', approve: 'Approve and save', editFirst: 'Edit before approving',
      leadStages: 'Pipeline stages', perAgent: 'by agent', history: 'History',
      nextFollowUp: 'Next follow-up', outcome: 'Outcome', confirm: 'Confirm visit',
      complete: 'Mark completed', publicPage: 'PUBLIC PAGE', contactCta: 'Contact on WhatsApp',
      views: 'page views', agencyInfo: 'Agency information',
      privateNote: 'The public page shows commercial information only. Internal CRM data stays private.',
    };

const caption = {
  dashboard:
    locale === 'es'
      ? 'Composición ilustrativa del panel de prioridades operativas de InmoCRM.'
      : 'Illustrative composition of the InmoCRM operational priorities dashboard.',
  property:
    locale === 'es'
      ? 'Composición ilustrativa de la ficha de propiedad con asistencia de IA.'
      : 'Illustrative composition of the property record with AI assistance.',
  pipeline:
    locale === 'es'
      ? 'Composición ilustrativa del pipeline comercial por estado de lead.'
      : 'Illustrative composition of the commercial pipeline by lead status.',
  visit:
    locale === 'es'
      ? 'Composición ilustrativa de la agenda de visitas y su resultado.'
      : 'Illustrative composition of the visit schedule and its outcome.',
  public:
    locale === 'es'
      ? 'Composición ilustrativa de la página pública de una propiedad.'
      : 'Illustrative composition of a property public page.',
}[view];
---

<figure class:list={['inmo-ui', `is-${view}`, { compact }]} aria-label={caption}>
  <div class="browser" aria-hidden="true">
    <div class="browser-bar">
      <span class="browser-dots"><i></i><i></i><i></i></span>
      <span class="browser-title">{c.browserTitle}</span>
      <span class="browser-state">{c.sampleData}</span>
    </div>
    <div class="product-shell">
      {view !== 'public' && (
        <aside>
          <div class="brand"><span>I</span><b>InmoCRM</b></div>
          <nav>
            <span class:list={{ active: view === 'dashboard' }}>▦ <b>{c.dashboard}</b></span>
            <span class:list={{ active: view === 'property' }}>▤ <b>{c.properties}</b></span>
            <span class:list={{ active: view === 'pipeline' }}>◉ <b>{c.pipeline}</b></span>
            <span class:list={{ active: view === 'visit' }}>◎ <b>{c.visits}</b></span>
            <span>▦ <b>{c.tasks}</b></span>
            <span>◌ <b>{c.activity}</b></span>
          </nav>
          <div class="tenant"><i>PS</i><span>{c.agency}<small>{c.activeOrg}</small></span></div>
        </aside>
      )}

      <div class="workspace">
        {view === 'dashboard' && (
          <div class="dash-view">
            <header class="workspace-head">
              <div><small>{c.dayContext}</small><h3>{c.dashboard}</h3></div>
              <span class="avatar">PS</span>
            </header>
            <div class="priority-grid">
              <div class="priority hot"><span>{c.attentionToday}</span><strong>6</strong><small>{c.followUpOverdue} · {c.illustrativeFigures}</small></div>
              <div class="priority"><span>{c.noFollowUp}</span><strong>4</strong><small>{locale === 'es' ? 'Lucía · Martín · Ana · Diego' : 'Lucia · Martin · Ana · Diego'}</small></div>
              <div class="priority"><span>{c.incomplete}</span><strong>3</strong><small>{c.missingPhotos}</small></div>
              <div class="priority"><span>{c.upcomingVisits}</span><strong>5</strong><small>{c.scheduledToday}</small></div>
            </div>
            <div class="dash-lower">
              <section class="opp-panel">
                <div class="panel-head"><div><small>{locale === 'es' ? 'PIPELINE' : 'PIPELINE'}</small><b>{c.activeBlocked}</b></div><span>{c.viewAll}</span></div>
                <div class="opp-row"><i class="dot green"></i><b>{locale === 'es' ? 'Depto · Palermo · 3 amb' : 'Apt · Palermo · 3 bed'}</b><em>{locale === 'es' ? 'Negociación' : 'Negotiation'}</em></div>
                <div class="opp-row"><i class="dot amber"></i><b>{locale === 'es' ? 'Casa · Nordelta · 4 amb' : 'House · Nordelta · 4 bed'}</b><em>{c.blockedNegotiation}</em></div>
                <div class="opp-row"><i class="dot green"></i><b>{locale === 'es' ? 'Oficina · Microcentro' : 'Office · Downtown'}</b><em>{locale === 'es' ? 'Visita programada' : 'Visit scheduled'}</em></div>
              </section>
              <section class="agenda-panel">
                <div class="panel-head"><div><small>{locale === 'es' ? 'AGENDA' : 'SCHEDULE'}</small><b>{c.upcomingVisits}</b></div></div>
                <div class="agenda-row"><b>10:30</b><span>{locale === 'es' ? 'Visita · Palermo · con comprador' : 'Visit · Palermo · with buyer'}</span></div>
                <div class="agenda-row"><b>12:00</b><span>{locale === 'es' ? 'Visita · Caballito · con inquilino' : 'Visit · Caballito · with tenant'}</span></div>
                <div class="agenda-row"><b>16:45</b><span>{locale === 'es' ? 'Llamada de seguimiento' : 'Follow-up call'}</span></div>
              </section>
            </div>
          </div>
        )}

        {view === 'property' && (
          <div class="prop-view">
            <header class="workspace-head">
              <div><small>{c.recordTitle}</small><h3>{locale === 'es' ? 'Depto · Palermo · 3 amb' : 'Apt · Palermo · 3 bed'}</h3></div>
              <em class="status-pill">{locale === 'es' ? 'lista para publicar' : 'ready to publish'}</em>
            </header>
            <div class="prop-layout">
              <section class="media-panel">
                <div class="media-main"><span>{c.cover}</span></div>
                <div class="media-thumbs"><i></i><i></i><i></i><i class="empty"></i></div>
                <div class="quality"><div class="quality-bar"><i style="width:72%"></i></div><div><b>{c.quality} · 72/100</b><span>{c.qualityNote}</span></div></div>
              </section>
              <section class="detail-panel">
                <div class="detail-grid">
                  <div><small>{c.status}</small><b>{locale === 'es' ? 'lista para publicar' : 'ready to publish'}</b></div>
                  <div><small>{c.operation}</small><b>{locale === 'es' ? 'venta' : 'sale'}</b></div>
                  <div><small>{c.type}</small><b>{locale === 'es' ? 'departamento' : 'apartment'}</b></div>
                  <div><small>{c.responsible}</small><b>{locale === 'es' ? 'Martín Ríos' : 'Martin Rios'}</b></div>
                  <div><small>{c.owner}</small><b>{locale === 'es' ? 'Contacto propietario' : 'Owner contact'}</b></div>
                  <div><small>{c.attributes}</small><b>3 amb · 2 baños · 78 m²</b></div>
                </div>
                <div class="feat-tags"><span>{locale === 'es' ? 'balcón' : 'balcony'}</span><span>{locale === 'es' ? 'cochera' : 'parking'}</span><span>{locale === 'es' ? 'parrilla' : 'grill area'}</span></div>
                <div class="ai-panel">
                  <div class="ai-head"><span>✦</span><b>{c.aiAssist}</b></div>
                  <p>{c.aiNote}</p>
                  <div class="ai-preview"><small>{c.preview}</small><p>{locale === 'es' ? 'Departamento luminoso de 3 ambientes a dos cuadras del parque, con balcón al frente y cochera fija…' : 'Bright 3-room apartment two blocks from the park, with a front balcony and dedicated parking…'}</p></div>
                  <div class="ai-actions"><span class="action solid">{c.approve}</span><span class="action ghost">{c.editFirst}</span></div>
                </div>
              </section>
            </div>
          </div>
        )}

        {view === 'pipeline' && (
          <div class="pipe-view">
            <header class="workspace-head">
              <div><small>{c.leadStages.toUpperCase()} · {c.perAgent.toUpperCase()}</small><h3>{c.pipeline}</h3></div>
              <span class="avatar">PS</span>
            </header>
            <div class="kanban">
              <div class="column"><header><b>{locale === 'es' ? 'Nuevo' : 'New'}</b><span>3</span></header><div class="card"><b>{locale === 'es' ? 'Consulta · Instagram' : 'Inquiry · Instagram'}</b><span>{c.nextFollowUp}: {locale === 'es' ? 'hoy' : 'today'}</span></div><div class="card"><b>{locale === 'es' ? 'Formulario web' : 'Website form'}</b><span>{c.nextFollowUp}: {locale === 'es' ? 'mañana' : 'tomorrow'}</span></div></div>
              <div class="column"><header><b>{locale === 'es' ? 'Contactado' : 'Contacted'}</b><span>4</span></header><div class="card"><b>WhatsApp · Palermo</b><span>{locale === 'es' ? 'Martín · presupuesto registrado' : 'Martin · budget recorded'}</span></div><div class="card alert"><b>{locale === 'es' ? 'Referido · Nordelta' : 'Referral · Nordelta'}</b><span>⚠ {c.followUpOverdue}</span></div></div>
              <div class="column"><header><b>{locale === 'es' ? 'Calificado' : 'Qualified'}</b><span>2</span></header><div class="card"><b>{locale === 'es' ? 'Comprador · 3 amb' : 'Buyer · 3 bed'}</b><span>{c.history}: 3 {locale === 'es' ? 'movimientos' : 'moves'}</span></div></div>
              <div class="column"><header><b>{locale === 'es' ? 'Visita programada' : 'Visit scheduled'}</b><span>3</span></header><div class="card"><b>{locale === 'es' ? 'Visita · Caballito' : 'Visit · Caballito'}</b><span>{c.scheduledToday}</span></div></div>
              <div class="column"><header><b>{locale === 'es' ? 'Negociación' : 'Negotiation'}</b><span>1</span></header><div class="card alert"><b>{locale === 'es' ? 'Casa · Nordelta' : 'House · Nordelta'}</b><span>⚠ {c.blockedNegotiation}</span></div></div>
            </div>
          </div>
        )}

        {view === 'visit' && (
          <div class="visit-view">
            <header class="workspace-head">
              <div><small>{locale === 'es' ? 'CITAS · VISITAS A PROPIEDADES' : 'APPOINTMENTS · PROPERTY VISITS'}</small><h3>{c.visits}</h3></div>
              <span class="action solid">{c.confirm}</span>
            </header>
            <div class="visit-layout">
              <section class="visit-card">
                <div class="visit-top"><b>{locale === 'es' ? 'Visita · Depto Palermo' : 'Visit · Palermo Apt'}</b><em>{locale === 'es' ? 'confirmada' : 'confirmed'}</em></div>
                <div class="visit-meta"><div><small>{locale === 'es' ? 'PROPIEDAD' : 'PROPERTY'}</small><b>{locale === 'es' ? 'Depto · Palermo · 3 amb' : 'Apt · Palermo · 3 bed'}</b></div><div><small>{locale === 'es' ? 'CONTACTO / LEAD' : 'CONTACT / LEAD'}</small><b>{locale === 'es' ? 'Compradora · WhatsApp' : 'Buyer · WhatsApp'}</b></div><div><small>{locale === 'es' ? 'AGENTE' : 'AGENT'}</small><b>{locale === 'es' ? 'Martín Ríos' : 'Martin Rios'}</b></div><div><small>{locale === 'es' ? 'HORARIO' : 'TIME'}</small><b>{locale === 'es' ? 'Hoy · 10:30' : 'Today · 10:30 AM'}</b></div></div>
                <div class="visit-notes"><small>{locale === 'es' ? 'NOTAS Y RESULTADO' : 'NOTES AND OUTCOME'}</small><p>{locale === 'es' ? 'La compradora confirma interés. Coordinar segunda visita con cotitular y registrar el resultado en la línea de tiempo.' : 'The buyer confirms interest. Schedule a second visit with the co-buyer and record the outcome in the timeline.'}</p></div>
                <span class="action solid full">{c.complete}</span>
              </section>
              <section class="visit-side">
                <div class="panel-head"><div><small>{locale === 'es' ? 'SEMANA' : 'WEEK'}</small><b>{c.upcomingVisits}</b></div></div>
                <div class="agenda-row"><b>{locale === 'es' ? 'Hoy 10:30' : 'Today 10:30 AM'}</b><span>Palermo · {locale === 'es' ? 'confirmada' : 'confirmed'}</span></div>
                <div class="agenda-row"><b>{locale === 'es' ? 'Hoy 12:00' : 'Today 12:00 PM'}</b><span>Caballito · {locale === 'es' ? 'programada' : 'scheduled'}</span></div>
                <div class="agenda-row"><b>{locale === 'es' ? 'Mañana 16:00' : 'Tomorrow 4:00 PM'}</b><span>Nordelta · {locale === 'es' ? 'reprogramada' : 'rescheduled'}</span></div>
                <div class="agenda-row done"><b>{locale === 'es' ? 'Ayer 18:00' : 'Yesterday 6:00 PM'}</b><span>{locale === 'es' ? 'realizada · con notas' : 'completed · with notes'}</span></div>
                <p class="side-note">{c.outcome} → {locale === 'es' ? 'línea de tiempo y actividad' : 'timeline and activity log'}</p>
              </section>
            </div>
          </div>
        )}

        {view === 'public' && (
          <div class="public-view">
            <div class="public-hero"><span>{c.publicPage}</span><h3>{locale === 'es' ? 'Depto · Palermo · 3 amb' : 'Apt · Palermo · 3 bed'}</h3><p>{locale === 'es' ? 'Venta · 78 m² · 3 ambientes · 2 baños' : 'Sale · 78 m² · 3 rooms · 2 baths'}</p></div>
            <div class="public-gallery"><i></i><i></i><i></i></div>
            <p class="public-desc">{locale === 'es' ? 'Departamento luminoso a dos cuadras del parque, con balcón al frente, cocina integrada y cochera fija. Texto aprobado por el equipo antes de publicar.' : 'Bright apartment two blocks from the park, with a front balcony, open kitchen and dedicated parking. Copy approved by the team before publishing.'}</p>
            <div class="public-cta"><span class="action solid">{c.contactCta}</span><span class="views">👁 248 {c.views}</span></div>
            <div class="public-agency"><small>{c.agencyInfo}</small><b>{c.agency}</b><span>{c.privateNote}</span></div>
          </div>
        )}
      </div>
    </div>
  </div>
  <figcaption>{caption} <span>{locale === 'es' ? 'Los datos son ilustrativos.' : 'Data shown is illustrative.'}</span></figcaption>
</figure>

<style>
  .inmo-ui { margin: 0; color: #111318; --inmo: #0e7c72; --inmo-deep: #0b3b37; --inmo-soft: #e2f2ee; --sand: #faf7f1; }
  .browser { background: #fff; border: 1px solid rgba(227,231,237,.95); border-top: 3px solid var(--inmo); border-radius: 18px; overflow: hidden; box-shadow: 0 70px 130px -38px rgba(14,124,114,.45), 0 28px 58px -34px rgba(4,10,30,.55); }
  .browser-bar { min-height: 46px; padding: 0 17px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; border-bottom: 1px solid #e3e7ed; background: var(--sand); font-family: var(--mono); font-size: 9px; letter-spacing: .12em; color: #667085; }
  .browser-dots { display: flex; gap: 6px; }
  .browser-dots i { width: 8px; height: 8px; border-radius: 50%; background: #d2d9e4; }
  .browser-state { justify-self: end; color: var(--inmo); }
  .product-shell { display: grid; grid-template-columns: 192px minmax(0, 1fr); min-height: 520px; }
  aside { padding: 22px 14px 16px; background: var(--sand); border-right: 1px solid #ece5d5; color: #2b2620; display: flex; flex-direction: column; }
  .brand { display: flex; align-items: center; gap: 9px; padding: 0 8px 23px; font-family: var(--disp); letter-spacing: .04em; }
  .brand span { width: 28px; height: 28px; display: grid; place-items: center; background: var(--inmo); border-radius: 8px; font-size: 13px; color: #fff; }
  aside nav { display: grid; gap: 3px; }
  aside nav span { display: flex; align-items: center; gap: 10px; min-height: 39px; padding: 0 10px; border-radius: 8px; color: #6b6455; font-size: 11px; }
  aside nav span.active { background: var(--inmo-soft); color: var(--inmo-deep); font-weight: 600; }
  aside nav b { font-weight: 500; }
  .tenant { margin-top: auto; padding: 12px 8px 2px; border-top: 1px solid #e3dcc8; display: flex; align-items: center; gap: 9px; font-size: 10px; }
  .tenant i { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: var(--inmo-deep); color: #fff; font-style: normal; font-weight: 700; }
  .tenant small { display: block; color: #8a8271; }
  .workspace { min-width: 0; padding: 25px 28px 27px; background: #fbfcfa; }
  .workspace-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
  .workspace-head small, .panel-head small, .visit-meta small, .visit-notes small, .public-agency small { display: block; font-family: var(--mono); font-size: 8.5px; letter-spacing: .13em; color: #7a8496; }
  .workspace-head h3 { margin-top: 3px; font-family: var(--disp); font-size: 24px; line-height: 1.1; }
  .avatar { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 50%; background: var(--inmo-soft); color: var(--inmo-deep); font: 600 9px var(--mono); }
  .panel-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .panel-head b { display: block; margin-top: 2px; font: 600 13px var(--disp); }
  .panel-head > span { padding: 4px 8px; border: 1px solid #e3e7ed; border-radius: 999px; color: #667085; font-size: 8px; }
  .priority-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .priority { padding: 14px; border: 1px solid #e3e7ed; border-radius: 11px; background: #fff; }
  .priority.hot { border-color: var(--inmo); box-shadow: inset 3px 0 var(--inmo); }
  .priority span { display: block; font-size: 10px; color: #667085; }
  .priority strong { display: block; margin-top: 5px; font: 600 22px var(--disp); }
  .priority small { display: block; margin-top: 2px; color: #8992a2; font-size: 8px; }
  .dash-lower { display: grid; grid-template-columns: 1.5fr .9fr; gap: 11px; margin-top: 11px; }
  .dash-lower > section, .visit-card, .visit-side, .media-panel, .detail-panel { border: 1px solid #e3e7ed; border-radius: 11px; background: #fff; }
  .opp-panel, .agenda-panel, .visit-side { padding: 15px; }
  .opp-row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 8px; padding: 9px 0; border-top: 1px solid #edf0f4; font-size: 9px; }
  .opp-row b { font-weight: 600; }
  .opp-row em { font-style: normal; color: #667085; }
  .dot { width: 8px; height: 8px; border-radius: 50%; }
  .dot.green { background: var(--inmo); } .dot.amber { background: #d29a2b; }
  .agenda-row { display: flex; gap: 10px; align-items: baseline; padding: 8px 0; border-top: 1px solid #edf0f4; font-size: 9px; }
  .agenda-row b { color: var(--inmo-deep); white-space: nowrap; }
  .agenda-row span { color: #596579; }
  .agenda-row.done span { color: #8a94a3; }
  .prop-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: 11px; }
  .media-panel { padding: 15px; }
  .media-main { height: 150px; border-radius: 9px; background: linear-gradient(135deg, #dcebe5, #f4efe2 60%, #e8ded0); border: 1px solid #e3e7ed; display: flex; align-items: flex-end; padding: 8px; }
  .media-main span { padding: 3px 8px; border-radius: 999px; background: rgba(255,255,255,.9); color: var(--inmo-deep); font: 8px var(--mono); }
  .media-thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 8px; }
  .media-thumbs i { height: 42px; border-radius: 6px; background: linear-gradient(135deg, #e7efe9, #efe7d6); border: 1px solid #e3e7ed; }
  .media-thumbs i.empty { background: #fff; border-style: dashed; }
  .quality { display: grid; grid-template-columns: 1fr; gap: 8px; margin-top: 12px; }
  .quality-bar { height: 7px; border-radius: 99px; background: #edf0f4; overflow: hidden; }
  .quality-bar i { display: block; height: 100%; background: var(--inmo); }
  .quality b { display: block; font: 600 10px var(--disp); }
  .quality span { display: block; color: #667085; font-size: 8px; }
  .detail-panel { padding: 17px; }
  .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
  .detail-grid small { display: block; font: 7.5px var(--mono); letter-spacing: .1em; color: #7a8496; }
  .detail-grid b { display: block; font-size: 10px; }
  .feat-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .feat-tags span { padding: 5px 9px; border-radius: 999px; background: var(--sand); border: 1px solid #ece5d5; color: #6b6455; font-size: 8px; }
  .ai-panel { margin-top: 12px; padding: 12px; border: 1px dashed #9cc9c0; border-radius: 9px; background: #f2faf8; }
  .ai-head { display: flex; align-items: center; gap: 7px; font-size: 10px; color: var(--inmo-deep); }
  .ai-head span { color: var(--inmo); }
  .ai-panel > p { margin-top: 6px; color: #596579; font-size: 8px; }
