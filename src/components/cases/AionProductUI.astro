---
interface Props {
  locale: 'es' | 'en';
  view?: 'dashboard' | 'member' | 'cash';
  compact?: boolean;
}

const { locale, view = 'dashboard', compact = false } = Astro.props;
const c = locale === 'es'
  ? {
      browserTitle: 'AION WELLNESS · OPERACIÓN', sampleData: 'DATOS DE EJEMPLO', overview: 'Resumen',
      members: 'Lista de socios', recordPayment: 'Registrar pago', plans: 'Planes', reception: 'Recepción',
      dailyClose: 'Cierre diario', settings: 'Configuración', organization: 'Centro Norte', activeOperation: 'Operación activa',
      dayContext: 'VIERNES · OPERACIÓN DIARIA', search: 'Buscar socio…', todayRevenue: 'Ingresos de hoy',
      sampleCurrency: 'ARS · dato ilustrativo', checkIns: 'Check-ins', peakHour: 'Hora pico · 18:00',
      activeMembers: 'Socios activos', monthlySignups: '34 altas este mes', expiring: 'Por vencer', nextDays: 'Próximos 7 días',
      lastDays: 'ÚLTIMOS 7 DÍAS', revenueActivity: 'Ingresos y actividad', weekly: 'Semanal',
      days: ['SÁB', 'DOM', 'LUN', 'MAR', 'MIÉ', 'JUE', 'VIE'], todayPayments: 'COBROS DE HOY',
      paymentMethods: 'Medios de pago', methods: 'medios', transfer: 'Transferencia', cash: 'Efectivo', card: 'Tarjeta',
      accessControl: 'Control de acceso', lastCheckIn: 'último check-in registrado', accessGranted: 'Acceso autorizado',
      memberFilter: 'Nombre, documento o email', allStatuses: 'Todos los estados', newMember: 'Nuevo socio', member: 'SOCIO',
      membership: 'MEMBRESÍA', expiration: 'VENCIMIENTO', status: 'ESTADO', monthlyUses: 'Mensual · 12 usos',
      quarterlyOpen: 'Trimestral · libre', monthlyEight: 'Mensual · 8 usos', active: 'Activa', renewMembership: 'Renovar membresía',
      plan: 'Plan', amount: 'Importe', method: 'Medio', splitPayment: 'Un pago puede combinar medios y monedas configuradas.',
      confirmRenewal: 'Confirmar pago y renovación', operationalDate: 'FECHA OPERATIVA', date: '11 septiembre 2026',
      open: 'Abierto', performClose: 'Realizar cierre', daySummary: 'RESUMEN DEL DÍA', recordedMovements: 'Movimientos registrados',
      recordedTotal: 'Total registrado', live: 'En vivo', activeMembershipEntry: 'Membresía activa · ingreso registrado',
      grace: 'Gracia', configured: 'Configurada', cooldown: 'Cooldown', enabled: 'Activo'
    }
  : {
      browserTitle: 'AION WELLNESS · OPERATIONS', sampleData: 'SAMPLE DATA', overview: 'Overview',
      members: 'Member list', recordPayment: 'Record payment', plans: 'Plans', reception: 'Reception',
      dailyClose: 'Daily close', settings: 'Settings', organization: 'North Fitness', activeOperation: 'Active operation',
      dayContext: 'FRIDAY · DAILY OPERATIONS', search: 'Search member…', todayRevenue: 'Today’s revenue',
      sampleCurrency: 'ARS · illustrative data', checkIns: 'Check-ins', peakHour: 'Peak hour · 6:00 PM',
      activeMembers: 'Active members', monthlySignups: '34 signups this month', expiring: 'Expiring soon', nextDays: 'Next 7 days',
      lastDays: 'LAST 7 DAYS', revenueActivity: 'Revenue and activity', weekly: 'Weekly',
      days: ['SAT', 'SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI'], todayPayments: 'TODAY’S PAYMENTS',
      paymentMethods: 'Payment methods', methods: 'methods', transfer: 'Bank transfer', cash: 'Cash', card: 'Card',
      accessControl: 'Access control', lastCheckIn: 'latest recorded check-in', accessGranted: 'Access granted',
      memberFilter: 'Name, document or email', allStatuses: 'All statuses', newMember: 'New member', member: 'MEMBER',
      membership: 'MEMBERSHIP', expiration: 'EXPIRATION', status: 'STATUS', monthlyUses: 'Monthly · 12 visits',
      quarterlyOpen: 'Quarterly · unlimited', monthlyEight: 'Monthly · 8 visits', active: 'Active', renewMembership: 'Renew membership',
      plan: 'Plan', amount: 'Amount', method: 'Method', splitPayment: 'A payment can combine configured methods and currencies.',
      confirmRenewal: 'Confirm payment and renewal', operationalDate: 'OPERATIONAL DATE', date: 'September 11, 2026',
      open: 'Open', performClose: 'Close day', daySummary: 'DAILY SUMMARY', recordedMovements: 'Recorded movements',
      recordedTotal: 'Recorded total', live: 'Live', activeMembershipEntry: 'Active membership · entry recorded',
      grace: 'Grace period', configured: 'Configured', cooldown: 'Cooldown', enabled: 'Enabled'
    };
const caption = {
  dashboard:
    locale === 'es'
      ? 'Composición ilustrativa del resumen operativo de AION Wellness.'
      : 'Illustrative composition of the AION Wellness operational overview.',
  member:
    locale === 'es'
      ? 'Composición ilustrativa del flujo entre socios, membresías y pagos.'
      : 'Illustrative composition of the member, membership and payment workflow.',
  cash:
    locale === 'es'
      ? 'Composición ilustrativa del cierre diario y el registro de cobros.'
      : 'Illustrative composition of daily cash close and recorded payments.'
}[view];
---

<figure class:list={['aion-ui', `is-${view}`, { compact }]} aria-label={caption}>
  <div class="browser" aria-hidden="true">
    <div class="browser-bar">
      <span class="browser-dots"><i></i><i></i><i></i></span>
      <span class="browser-title">{c.browserTitle}</span>
      <span class="browser-state">{c.sampleData}</span>
    </div>
    <div class="product-shell">
      <aside>
        <div class="brand"><span>A</span><b>AION</b></div>
        <nav>
          <span class:list={{ active: view === 'dashboard' }}>▦ <b>{c.overview}</b></span>
          <span class:list={{ active: view === 'member' }}>◉ <b>{c.members}</b></span>
          <span class:list={{ active: view === 'member' }}>＋ <b>{c.recordPayment}</b></span>
          <span>▤ <b>{c.plans}</b></span>
          <span>⌁ <b>{c.reception}</b></span>
          <span class:list={{ active: view === 'cash' }}>▣ <b>{c.dailyClose}</b></span>
          <span>⚙ <b>{c.settings}</b></span>
        </nav>
        <div class="tenant"><i>NW</i><span>{c.organization}<small>{c.activeOperation}</small></span></div>
      </aside>

      <div class="workspace">
        <header class="workspace-head">
          <div>
            <small>{c.dayContext}</small>
            <h3>{view === 'dashboard' ? c.overview : view === 'member' ? c.members : c.dailyClose}</h3>
          </div>
          <div class="head-actions"><span class="search">{c.search}</span><span class="avatar">NW</span></div>
        </header>

        {view === 'dashboard' && (
          <div class="dashboard-view">
            <div class="metric-row">
              <div><span>{c.todayRevenue}</span><strong>$ 428.500</strong><small>{c.sampleCurrency}</small></div>
              <div><span>{c.checkIns}</span><strong>86</strong><small>{c.peakHour}</small></div>
              <div><span>{c.activeMembers}</span><strong>642</strong><small>{c.monthlySignups}</small></div>
              <div><span>{c.expiring}</span><strong>27</strong><small>{c.nextDays}</small></div>
            </div>
            <div class="dashboard-grid">
              <section class="chart-panel">
                <div class="panel-head"><div><small>{c.lastDays}</small><b>{c.revenueActivity}</b></div><span>{c.weekly}</span></div>
                <div class="chart">
                  <div class="grid-lines"><i></i><i></i><i></i><i></i></div>
                  <svg viewBox="0 0 520 170" preserveAspectRatio="none">
                    <defs><linearGradient id="aionChart" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2758d9" stop-opacity=".24"/><stop offset="1" stop-color="#2758d9" stop-opacity="0"/></linearGradient></defs>
                    <path d="M0 145 C65 130 70 84 130 96 S210 139 265 92 S346 44 390 70 S462 104 520 30 L520 170 L0 170Z" fill="url(#aionChart)"/>
                    <path d="M0 145 C65 130 70 84 130 96 S210 139 265 92 S346 44 390 70 S462 104 520 30" fill="none" stroke="#2758d9" stroke-width="3"/>
                    <g fill="#fff" stroke="#2758d9" stroke-width="3"><circle cx="130" cy="96" r="4"/><circle cx="265" cy="92" r="4"/><circle cx="390" cy="70" r="4"/><circle cx="520" cy="30" r="4"/></g>
                  </svg>
                  <div class="days">{c.days.map((day) => <span>{day}</span>)}</div>
                </div>
              </section>
              <section class="breakdown">
                <div class="panel-head"><div><small>{c.todayPayments}</small><b>{c.paymentMethods}</b></div></div>
                <div class="donut"><span><b>3</b><small>{c.methods}</small></span></div>
                <ul><li><i class="blue"></i>{c.transfer} <b>48%</b></li><li><i class="navy"></i>{c.cash} <b>32%</b></li><li><i class="pale"></i>{c.card} <b>20%</b></li></ul>
              </section>
            </div>
            <div class="activity-strip"><span><i></i><b>{c.accessControl}</b> · {c.lastCheckIn}</span><strong>{c.accessGranted}</strong></div>
          </div>
        )}

        {view === 'member' && (
          <div class="member-view">
            <div class="member-toolbar"><span class="filter">{c.memberFilter}</span><span>{c.allStatuses}</span><span class="action">＋ {c.newMember}</span></div>
            <div class="member-layout">
              <section class="member-list">
                <div class="table-head"><span>{c.member}</span><span>{c.membership}</span><span>{c.expiration}</span><span>{c.status}</span></div>
                <div class="member-row selected"><span><i>LM</i><b>Lucía Méndez<small>{locale === 'es' ? 'DNI' : 'ID'} · 32.***.***</small></b></span><span>{c.monthlyUses}</span><span>{locale === 'es' ? '18 sep' : 'Sep 18'}</span><em>{c.active}</em></div>
                <div class="member-row"><span><i>MR</i><b>Martín Ríos<small>{locale === 'es' ? 'DNI' : 'ID'} · 28.***.***</small></b></span><span>{c.quarterlyOpen}</span><span>{locale === 'es' ? '21 sep' : 'Sep 21'}</span><em>{c.active}</em></div>
                <div class="member-row"><span><i>AS</i><b>Ana Silva<small>{locale === 'es' ? 'DNI' : 'ID'} · 35.***.***</small></b></span><span>{c.monthlyEight}</span><span>{locale === 'es' ? '12 sep' : 'Sep 12'}</span><em class="warning">{c.expiring}</em></div>
              </section>
              <section class="payment-panel">
                <small>{c.recordPayment.toUpperCase()}</small><h4>{c.renewMembership}</h4>
                <label>{locale === 'es' ? 'Socio' : 'Member'}<strong>Lucía Méndez</strong></label>
                <label>{c.plan}<strong>{c.monthlyUses}</strong></label>
                <div class="split"><label>{c.amount}<strong>$ 36.000 ARS</strong></label><label>{c.method}<strong>{c.transfer}</strong></label></div>
                <div class="payment-note">{c.splitPayment}</div>
                <span class="action full">{c.confirmRenewal}</span>
              </section>
            </div>
          </div>
        )}

        {view === 'cash' && (
          <div class="cash-view">
            <div class="close-summary">
              <div><small>{c.operationalDate}</small><b>{c.date}</b></div>
              <div><small>{c.status}</small><em>{c.open}</em></div>
              <span class="action">{c.performClose}</span>
            </div>
            <div class="cash-grid">
              <section>
                <div class="panel-head"><div><small>{c.daySummary}</small><b>{c.recordedMovements}</b></div></div>
                <div class="cash-total"><span>{c.recordedTotal}</span><strong>$ 428.500</strong><small>{c.sampleCurrency}</small></div>
                <div class="cash-lines"><div><span>{c.transfer}</span><b>$ 205.680</b></div><div><span>{c.cash}</span><b>$ 137.120</b></div><div><span>{c.card}</span><b>$ 85.700</b></div></div>
              </section>
              <section class="access-log">
                <div class="panel-head"><div><small>{c.reception.toUpperCase()}</small><b>{c.accessControl}</b></div><span>{c.live}</span></div>
                <div class="access-decision"><i>✓</i><div><b>{c.accessGranted}</b><span>{c.activeMembershipEntry}</span></div></div>
                <div class="policy"><span>{c.grace}</span><b>{c.configured}</b><span>{c.cooldown}</span><b>{c.enabled}</b></div>
              </section>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
  <figcaption>{caption} <span>{locale === 'es' ? 'Los datos son ilustrativos.' : 'Data shown is illustrative.'}</span></figcaption>
</figure>

<style>
  .aion-ui { margin: 0; color: #111318; }
  .browser { background: #fff; border: 1px solid rgba(227,231,237,.95); border-top: 3px solid var(--accent); border-radius: 18px; overflow: hidden; box-shadow: 0 70px 130px -38px rgba(39,88,217,.62), 0 28px 58px -34px rgba(4,10,30,.68); }
  .browser-bar { min-height: 46px; padding: 0 17px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; border-bottom: 1px solid #e3e7ed; background: #f7f8fa; font-family: var(--mono); font-size: 9px; letter-spacing: .12em; color: #667085; }
  .browser-dots { display: flex; gap: 6px; }
  .browser-dots i { width: 8px; height: 8px; border-radius: 50%; background: #d2d9e4; }
  .browser-state { justify-self: end; color: #2758d9; }
  .product-shell { display: grid; grid-template-columns: 188px minmax(0, 1fr); min-height: 520px; }
  aside { padding: 22px 14px 16px; background: #102654; color: #fff; display: flex; flex-direction: column; }
  .brand { display: flex; align-items: center; gap: 9px; padding: 0 8px 23px; font-family: var(--disp); letter-spacing: .08em; }
  .brand span { width: 28px; height: 28px; display: grid; place-items: center; background: #2758d9; border-radius: 8px; font-size: 13px; }
  aside nav { display: grid; gap: 3px; }
  aside nav span { display: flex; align-items: center; gap: 10px; min-height: 39px; padding: 0 10px; border-radius: 8px; color: #aebbd3; font-size: 11px; }
  aside nav span.active { background: rgba(255,255,255,.11); color: #fff; }
  aside nav b { font-weight: 500; }
  .tenant { margin-top: auto; padding: 12px 8px 2px; border-top: 1px solid rgba(255,255,255,.13); display: flex; align-items: center; gap: 9px; font-size: 10px; color: #e4e9f0; }
  .tenant i { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: #fff; color: #102654; font-style: normal; font-weight: 700; }
  .tenant small { display: block; color: #9db0d0; }
  .workspace { min-width: 0; padding: 25px 28px 27px; background: #fbfcfe; }
  .workspace-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
  .workspace-head small, .panel-head small, .payment-panel > small, .close-summary small { display: block; font-family: var(--mono); font-size: 8.5px; letter-spacing: .13em; color: #7a8496; }
  .workspace-head h3 { margin-top: 3px; font-family: var(--disp); font-size: 24px; line-height: 1.1; }
  .head-actions { display: flex; align-items: center; gap: 9px; }
  .search { width: 180px; padding: 8px 13px; border: 1px solid #e3e7ed; border-radius: 999px; background: #fff; color: #8992a2; font-size: 10px; }
  .avatar { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 50%; background: #dce6ff; color: #2758d9; font: 600 9px var(--mono); }
  .metric-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .metric-row > div { padding: 14px; border: 1px solid #e3e7ed; border-radius: 11px; background: #fff; }
  .metric-row span { display: block; font-size: 10px; color: #667085; }
  .metric-row strong { display: block; margin-top: 5px; font: 600 19px var(--disp); letter-spacing: -.02em; }
  .metric-row small { display: block; margin-top: 2px; color: #8992a2; font-size: 8px; }
  .dashboard-grid, .cash-grid { display: grid; grid-template-columns: 1.65fr .75fr; gap: 11px; margin-top: 11px; }
  .dashboard-grid > section, .cash-grid > section, .member-list, .payment-panel { border: 1px solid #e3e7ed; border-radius: 11px; background: #fff; }
  .chart-panel, .breakdown, .cash-grid > section { padding: 15px; }
  .panel-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .panel-head b { display: block; margin-top: 2px; font: 600 13px var(--disp); }
  .panel-head > span { padding: 4px 8px; border: 1px solid #e3e7ed; border-radius: 999px; color: #667085; font-size: 8px; }
  .chart { position: relative; height: 174px; margin-top: 8px; }
  .chart svg { position: absolute; inset: 8px 0 17px; width: 100%; height: calc(100% - 25px); overflow: visible; }
  .grid-lines { position: absolute; inset: 8px 0 18px; display: flex; flex-direction: column; justify-content: space-between; }
  .grid-lines i { border-top: 1px dashed #e8ebf0; }
  .days { position: absolute; inset: auto 0 0; display: flex; justify-content: space-between; font: 7px var(--mono); color: #8b94a3; }
  .donut { width: 102px; height: 102px; margin: 18px auto 12px; display: grid; place-items: center; border-radius: 50%; background: conic-gradient(#2758d9 0 48%, #102654 48% 80%, #dce6ff 80%); }
  .donut::before { content: ''; grid-area: 1/1; width: 66px; height: 66px; border-radius: 50%; background: #fff; }
  .donut span { z-index: 1; grid-area: 1/1; text-align: center; }
  .donut b, .donut small { display: block; line-height: 1.05; }
  .donut b { font: 600 18px var(--disp); }
  .donut small { color: #667085; font-size: 8px; }
  .breakdown ul { list-style: none; }
  .breakdown li { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 7px; padding: 6px 0; border-top: 1px solid #edf0f4; font-size: 9px; color: #667085; }
  .breakdown li i { width: 6px; height: 6px; border-radius: 50%; }.blue{background:#2758d9}.navy{background:#102654}.pale{background:#dce6ff}
  .activity-strip { display: flex; justify-content: space-between; gap: 12px; margin-top: 11px; padding: 11px 14px; border: 1px solid #cbd8f7; border-radius: 10px; background: #f2f5fb; font-size: 9px; color: #596579; }
  .activity-strip i { display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: #2758d9; }
  .activity-strip strong { color: #2758d9; }
  .member-toolbar { display: flex; gap: 8px; margin-bottom: 11px; }
  .member-toolbar > span { padding: 9px 11px; border: 1px solid #e3e7ed; border-radius: 8px; background: #fff; color: #667085; font-size: 9px; }
  .member-toolbar .filter { flex: 1; }
  .action { display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; padding: 9px 12px; background: #2758d9; color: #fff; font: 600 9px var(--sans); }
  .member-layout { display: grid; grid-template-columns: 1.35fr .65fr; gap: 11px; }
  .member-list { overflow: hidden; }
  .table-head, .member-row { display: grid; grid-template-columns: 1.35fr 1fr .65fr .55fr; align-items: center; gap: 10px; padding: 12px 14px; }
  .table-head { background: #f7f8fa; font: 7.5px var(--mono); letter-spacing: .1em; color: #7a8496; }
  .member-row { border-top: 1px solid #edf0f4; font-size: 9px; color: #4e5869; }
  .member-row.selected { background: #f2f5fb; box-shadow: inset 3px 0 #2758d9; }
  .member-row > span:first-child { display: flex; align-items: center; gap: 8px; }
  .member-row i { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: #dce6ff; color: #2758d9; font-style: normal; font-weight: 700; }
  .member-row b, .member-row small { display: block; }.member-row small { color: #8992a2; font-weight: 400; }
  .member-row em, .close-summary em { justify-self: start; padding: 4px 7px; border-radius: 999px; background: #e8f6ef; color: #17714a; font-style: normal; font-size: 8px; }
  .member-row em.warning { background: #fff4dc; color: #8d5b00; }
  .payment-panel { padding: 17px; }
  .payment-panel h4 { margin: 3px 0 14px; font: 600 17px var(--disp); }
  .payment-panel label { display: block; margin-top: 8px; color: #7a8496; font-size: 8px; }
  .payment-panel label strong { display: block; margin-top: 3px; padding: 8px 9px; border: 1px solid #e3e7ed; border-radius: 7px; color: #303746; font-size: 9px; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
  .payment-note { margin: 11px 0; padding: 8px; background: #f2f5fb; color: #596579; font-size: 8px; }
  .payment-panel .full { width: 100%; }
  .close-summary { display: grid; grid-template-columns: 1fr 1fr auto; align-items: center; gap: 14px; padding: 14px 16px; border: 1px solid #e3e7ed; border-radius: 11px; background: #fff; }
  .close-summary b { display: block; margin-top: 3px; font: 600 12px var(--disp); }
  .cash-total { margin: 18px 0; padding: 17px; border-radius: 9px; background: #102654; color: #fff; }
  .cash-total span, .cash-total small { display: block; color: #b8c5dc; font-size: 8px; }.cash-total strong { display: block; font: 600 27px var(--disp); }
  .cash-lines div { display: flex; justify-content: space-between; padding: 8px 0; border-top: 1px solid #edf0f4; font-size: 9px; }
  .access-decision { display: flex; gap: 11px; align-items: center; margin: 20px 0; padding: 16px; border: 1px solid #b8ddca; border-radius: 9px; background: #f1faf5; }
  .access-decision i { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 50%; background: #17714a; color: #fff; font-style: normal; }
  .access-decision b, .access-decision span { display: block; }.access-decision b { font: 600 12px var(--disp); color: #155c3f; }.access-decision span { color: #58806d; font-size: 8px; }
  .policy { display: grid; grid-template-columns: 1fr auto; gap: 8px; padding-top: 10px; border-top: 1px solid #edf0f4; font-size: 8px; color: #667085; }
  figcaption { margin-top: 16px; text-align: center; color: rgba(255,255,255,.65); font: 10px/1.5 var(--mono); letter-spacing: .02em; }
  figcaption span { color: #9dbcfb; }
  .compact .browser { box-shadow: 0 55px 100px -42px rgba(39,88,217,.55); }
  .compact .product-shell { min-height: 400px; grid-template-columns: 148px minmax(0,1fr); }
  .compact aside { padding-top: 17px; }.compact aside nav span { min-height: 32px; font-size: 9px; }.compact .tenant { display: none; }
  .compact .workspace { padding: 19px; }.compact .workspace-head { margin-bottom: 15px; }.compact .metric-row strong { font-size: 15px; }.compact .chart { height: 127px; }.compact .activity-strip { display: none; }
  @media (max-width: 860px) {
    .product-shell, .compact .product-shell { grid-template-columns: 1fr; min-height: 0; }
    aside { display: none; }
    .workspace, .compact .workspace { padding: 20px; }
    .metric-row { grid-template-columns: repeat(2, 1fr); }
    .dashboard-grid, .cash-grid, .member-layout { grid-template-columns: 1fr; }
    .breakdown { display: none; }
    .chart { height: 150px; }
    .browser-title { display: none; }
    .browser-bar { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .browser { border-radius: 12px; }
    .workspace, .compact .workspace { padding: 15px; }
    .workspace-head { align-items: flex-start; }.search { display: none; }
    .metric-row { gap: 7px; }.metric-row > div { padding: 10px; }.metric-row strong { font-size: 15px; }
    .chart-panel { padding: 12px; }.chart { height: 122px; }
    .activity-strip { flex-direction: column; }
    .member-toolbar > span:not(.filter) { display: none; }
