---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/shared/WhatsAppButton.astro';
import { defaultLocale, type Locale } from '../i18n/config';
import { route, type RouteKey } from '../i18n/routes';

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  routeKey: RouteKey;
  canonicalPath: string;
  ogType?: string;
  alternatePaths?: Partial<Record<Locale, string>>;
}

const {
  locale = defaultLocale,
  title,
  description,
  routeKey,
  canonicalPath,
  ogType = 'website',
  alternatePaths
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://nextwrld.com';
const canonical = `${site}${canonicalPath}`;
const esPath = alternatePaths?.es ?? route(routeKey, 'es');
const enPath = alternatePaths?.en ?? route(routeKey, 'en');
const alternateLocale: Locale = locale === 'es' ? 'en' : 'es';
const alternatePath = alternateLocale === 'es' ? esPath : enPath;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={`${site}${esPath}`} />
    <link rel="alternate" hreflang="en" href={`${site}${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${esPath}`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <Header locale={locale} current={routeKey} alternatePath={alternatePath} />
    <main id="top">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppButton locale={locale} />
    <script src="../scripts/navigation.ts"></script>
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
